\ ***************************************************************************
\ NINJA MASSACRE for the BBC Micro - shared constants
\ ***************************************************************************

\ --- OS entry points -----------------------------------------------------

osfile  = &FFDD
oswrch  = &FFEE
osword  = &FFF1
osbyte  = &FFF4
oscli   = &FFF7

\ --- Hardware ------------------------------------------------------------

crtc_reg   = &FE00
crtc_data  = &FE01
ula_ctrl   = &FE20          ; the video ULA's control register
ula_pal    = &FE21          ; write (index << 4) | (physical EOR 7)
CRTC_BLANK = &30            ; R8: display enable skewed off, so nothing shows
sysvia_orb = &FE40          ; the addressable latch: bit 3 is keyboard enable
sysvia_ora = &FE41
sysvia_ddra = &FE43
sysvia_t1cl = &FE44
sysvia_t1ch = &FE45
sysvia_t1ll = &FE46
sysvia_t1lh = &FE47
sysvia_acr = &FE4B
sysvia_ora_nh = &FE4F       ; port A without handshake: the keyboard
sysvia_ifr = &FE4D
sysvia_ier = &FE4E          ; write bit 7 clear to disable the bits set
usrvia_t1cl = &FE64
usrvia_t1ch = &FE65
usrvia_t1ll = &FE66
usrvia_t1lh = &FE67
usrvia_t2cl = &FE68
usrvia_t2ch = &FE69
usrvia_acr = &FE6B
usrvia_ifr = &FE6D
usrvia_ier = &FE6E
irq1v      = &0204
romsel     = &FE30          ; the sideways bank at &8000
romshad    = &F4            ; the OS's copy of romsel: always write both
romtypes   = &02A1          ; the OS's ROM type per bank; 0 = no ROM found
\ The loader leaves the data's sideways RAM bank here for the game: user
\ zero page, which the DFS leaves alone.
DATA_BANK_ZP = &8F

\ --- The screen -----------------------------------------------------------
\ MODE 1's pixels (2 bits each, four to a byte), with the CRTC narrowed to
\ the Spectrum's 256x192 (as Chuckie Egg 2's port does): 64 CRTC columns
\ (32 Spectrum cells of 8 pixels, two bytes each) by 24 character rows. A
\ character row is 512 bytes, so the screen is 12K at the top of RAM and
\ row r starts at screen + r*&200.
SCREEN_COLS = 32                    ; Spectrum character cells across
SCREEN_ROWS = 24                    ; ... and down
ROW_BYTES   = SCREEN_COLS * 16      ; 512
screen      = &8000 - SCREEN_ROWS * ROW_BYTES

\ A byte with all four pixels in logical colour c: MODE 1 keeps a pixel's
\ high bit in the top nibble and its low bit in the bottom one.
FUNCTION cbyte(c) = (c AND 2) * &78 + (c AND 1) * &0F

\ The ULA's palette byte for logical colour l (MODE 1: l's bits are pixel
\ bits 7 and 3, so each colour has four of the sixteen entries; n picks
\ which) showing physical colour p.
FUNCTION ula_entry(l, n, p) = (((l AND 2) * 4 + (l AND 1) * 2 + (n AND 1) + (n AND 2) * 2) * 16) OR (p EOR 7)

\ Long branches, for when a routine outgrows the 6502's reach.
MACRO JNE target
    BEQ @+ : JMP target : .@
ENDMACRO
MACRO JEQ target
    BNE @+ : JMP target : .@
ENDMACRO

\ --- The music (music.6502) ------------------------------------------------

MU_VOICE   = &21            ; a voice's state: the original driver's &21 bytes
MU_AY_REGS = 12             ; the AY registers the driver keeps (0-11: &C47F-&C48A)
