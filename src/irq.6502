\ ***************************************************************************
\ The interrupt: the game owns IRQ1V, and services VSync, where it plays
\ the music, and the pass clock. start sets it up (startup.6502).

\ A pass's length (decision 12): the original's median, 1.22 frames of
\ 70,908 T-states at 3.5469 MHz, in microseconds (docs/brief.md, D4).
PASS_TICK = 24400
\ ***************************************************************************

.irq_handler
{
    \ The bass's edges first (bass.6502): their lateness is heard. (Only
    \ the interrupts enabled: a stopped bass's timer still sets its flag.)
    LDA usrvia_ifr : AND usrvia_ier
    ASL A : BCC not_user                        ; (bit 7: any of them)
    JMP bass_user                               ; (N: T1's)
.not_user
    LDA sysvia_ifr : AND sysvia_ier : AND #&20 : BEQ not_t2
    JMP bass_system
.not_t2
    BIT sysvia_ifr : BVC not_t1                 ; (T1 is bit 6)
    LDA sysvia_t1cl                             ; acknowledge T1
    INC passes
.not_t1
    LDA sysvia_ifr : AND #2 : BEQ done
    STA sysvia_ifr                              ; acknowledge VSync
    INC vsyncs
IF NOT(DEFINED(MUSICCHECK))
    \ The music's frame (music.6502), with interrupts on again so that the
    \ bass's edges aren't late by it. (The frame takes far less than a
    \ frame, so VSync can't come again inside it. The music check's build
    \ plays it itself, as fast as it goes.)
    LDA &FC : PHA                               ; (an interrupt's entry sets it)
    TXA : PHA : TYA : PHA
    CLI
    JSR music_tick
    SEI
    PLA : TAY : PLA : TAX
    PLA : STA &FC
ENDIF
.done
    LDA &FC                                     ; the OS saved A here
    RTI
}

\ Wait for the next VSync.
.wait_vsync
{
    LDA vsyncs
.wait
    CMP vsyncs : BEQ wait
    RTS
}
