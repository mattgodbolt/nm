\ ***************************************************************************
\ The players: their pass, controls, steps, the view's scroll, drawing
\ (&C168-&C1A5, &C967-&CE57; docs/research/players.md). The original has
\ the same code twice, once for each player; here it is once, for the
\ player in pl (0 or 1), its record at Player1 + prec. Positions are (row,
\ column) in characters: (rd, re) is the original's DE, D the row.
\ ***************************************************************************

P1_COLOUR = &45                 ; bright cyan on black (&CAEF)
P2_COLOUR = &44                 ; bright green (&CE13)
PIC_PLAYER = &30                ; the players' pictures: &30 + the facing (&CAED)
THROW_CHIRP = &3C               ; the throw's chirp (&CA29)

\ The controls, per player: magic, up, down, right, left, fire, as BBC
\ internal key numbers (decision 13).
C_MAGIC = 0
C_UP    = 1
C_DOWN  = 2
C_RIGHT = 3
C_LEFT  = 4
C_FIRE  = 5
CONTROLS = 6

\ Set player A's pl and prec.
.set_player
    STA pl
    TAX : LDA player_rec,X : STA prec
    RTS

\ &C168 Player1Pass, &C187 Player2Pass: if player A is in play, its pass;
\ then its code goes into the map under it (&D1A2). A player that leaves by
\ the exit returns from here (player_exits: pass_sp).
.player_pass
{
    JSR set_player
    LDX pl : LDA InPlay : AND in_play_bit,X : BEQ done
    TSX : STX pass_sp
    JSR player_update
    BNE drawn
    \ not drawn (the view couldn't scroll): the step bit, so it tries again
    LDX pl : LDA P1Facing,X : ORA pass_step_bit,X : STA P1Facing,X
.drawn
    LDX pl : LDY prec
    LDA Player1 + R_ROW,Y : STA rb
    LDA Player1 + R_COL,Y : STA rc
    LDA player_code,X : STA MapStamp
    JMP fill_cells
.done
    RTS
}
.in_play_bit
    EQUB 1, 2
\ (The original's player 2 sets bits 0 and 1 here, &C195: a facing of
\ right becomes left. Kept.)
.pass_step_bit
    EQUB 1, 3

\ &C978 Player1Update, &CC98 Player2Update: read the controls, throw or
\ move. Returns NZ when the player was drawn.
.player_update
{
    LDY prec
    LDA Player1 + R_COL,Y : STA OldPos
    LDA Player1 + R_ROW,Y : STA OldPos + 1
    \ frozen: no controls until it runs out
    LDX pl
    LDA P1Frozen,X : BEQ read_controls
    DEC P1Frozen,X
    JMP player_stay
.read_controls
    LDA #0 : STA rd : STA re        ; D: the horizontal step, E: the vertical
    \ magic: a smart bomb a pass while held, while there are any
    LDA #C_MAGIC : JSR control : BEQ up
    LDY prec : LDA Player1 + R_MAGIC,Y : BEQ up
    SEC : SBC #1 : STA Player1 + R_MAGIC,Y
    JSR smart_bomb
    JSR draw_view
    LDA #0 : STA rd : STA re        ; (the original keeps them in the alternate set)
.up
    LDA #C_UP : JSR control : BEQ down
    LDA #&FF : STA re
    LDA #4 : JSR set_facing
.down
    LDA #C_DOWN : JSR control : BEQ right
    LDA #1 : STA re
    LDA #6 : JSR set_facing
.right
    LDA #C_RIGHT : JSR control : BEQ left
    LDA #1 : STA rd
    LDA #0 : JSR set_facing
    JSR diagonal
.left
    LDA #C_LEFT : JSR control : BEQ fire
    LDA #&FF : STA rd
    LDA #2 : JSR set_facing
    JSR diagonal
.fire
    LDA #C_FIRE : JSR control : BEQ move
    \ fire: throw, if this player's star isn't flying
    LDX pl : LDY star_offset,X
    LDA Star1 + S_THROWER,Y : BNE stay
    \ the power counter: one off, if it isn't 0 (16 bits)
    LDY prec
    LDA Player1 + R_POWER,Y : BNE power_lo
    LDA Player1 + R_POWER + 1,Y : BEQ no_power
    SEC : SBC #1 : STA Player1 + R_POWER + 1,Y
    LDA #0
.power_lo
    SEC : SBC #1 : STA Player1 + R_POWER,Y
.no_power
    LDA Player1 + R_BOUNCES,Y : STA Bounces
    JSR launch_star
    LDA #THROW_CHIRP : JSR chirp
.stay
    JMP player_stay
.move
    \ &CA31: no direction, no move
    LDA rd : ORA re : BEQ stay
    LDA rd : STA rb                 ; B: the horizontal step
    LDA re : STA rc                 ; C: the vertical
    LDA re : STA StepV
    LDA rd : STA StepH
    \ lift the player out of the map (its cells at the start of the pass)
    LDA rb : PHA : LDA rc : PHA
    LDA OldPos + 1 : STA rb
    LDA OldPos : STA rc
    LDA #0 : STA MapStamp
    JSR fill_cells
    PLA : STA rc : PLA : STA rb
    LDY prec
    LDA Player1 + R_ROW,Y : STA rd
    LDA Player1 + R_COL,Y : STA re
    \ a new facing clears the step bit: a turn takes a pass
    LDX pl
    LDA P1LastFacing,X : EOR P1Facing,X : AND #&FE : BEQ same
    LDA P1Facing,X : AND #&FE : STA P1Facing,X
.same
    LDA P1Facing,X : STA P1LastFacing,X
    \ step when the step bit was set, and toggle it
    AND #1 : BEQ toggle
    LDA re : CLC : ADC rb : STA re
    LDA rd : CLC : ADC rc : STA rd
.toggle
    LDA P1Facing,X : EOR #1 : STA P1Facing,X
    JSR player_touch : BEQ place
    \ blocked: the step bit set, and slide: the horizontal step alone,
    \ then the vertical
    LDX pl : LDA P1Facing,X : ORA #1 : STA P1Facing,X
    LDY prec
    LDA Player1 + R_ROW,Y : STA rd
    LDA Player1 + R_COL,Y : CLC : ADC StepH : STA re
    JSR player_touch : BEQ place
    LDX pl : LDA P1Facing,X : ORA #1 : STA P1Facing,X
    LDY prec
    LDA Player1 + R_ROW,Y : CLC : ADC StepV : STA rd
    LDA Player1 + R_COL,Y : STA re
    JSR player_touch : BEQ place
    JMP player_stay
.place
    JMP player_place
}

\ Set the facing (pl's) to A, keeping its step bit (&C9BB).
.set_facing
{
    LDX pl : STA ra2
    LDA P1Facing,X : AND #1 : ORA ra2 : STA P1Facing,X
    RTS
}

\ &C967 Diagonal: a right or left facing gains 8 going up, 12 going down.
.diagonal
{
    LDA re : BEQ done
    LDX pl
    CMP #1 : BEQ down
    LDA P1Facing,X : CLC : ADC #8 : STA P1Facing,X
    RTS
.down
    LDA P1Facing,X : CLC : ADC #12 : STA P1Facing,X
.done
    RTS
}

\ Is player pl's control A held? NZ if so.
.control
{
    STA ra2
    LDA pl : ASL A : ADC pl : ASL A     ; (pl * CONTROLS)
    ADC ra2 : TAY
    LDX controls,Y
    JMP key_down
}
    ASSERT CONTROLS = 6

\ &CAA6 P1Stay: not moving: its position as it was.
.player_stay
{
    LDY prec
    LDA Player1 + R_ROW,Y : STA rd
    LDA Player1 + R_COL,Y : STA re
    \ (fall into player_place)
}

\ &CAAA P1Place, &CDCE: player pl to (rd, re): scroll the view if that's
\ outside the view's rows and columns 2-20, else store it, erase the old
\ picture if it moved, and draw. NZ when drawn.
.player_place
{
    \ the other player's position, for the scroll (H its row, L its column)
    LDA pl : EOR #1 : TAX : LDY player_rec,X
    LDA Player1 + R_ROW,Y : STA rh
    LDA Player1 + R_COL,Y : STA rl
    LDA rd : SEC : SBC ViewOrigin : STA rc
    CMP #PLACE_MAX + 1 : BCC not_down
    JMP scroll_down
.not_down
    CMP #PLACE_MIN : BCS not_up
    JMP scroll_up
.not_up
    LDA re : SEC : SBC ViewOrigin + 1
    CMP #PLACE_MAX + 1 : BCC not_right
    JMP scroll_right
.not_right
    CMP #PLACE_MIN : BCS not_left
    JMP scroll_left
.not_left
    CLC : ADC #VIEW_LEFT : STA ra2  ; the screen column
    LDY prec
    LDA rd : STA Player1 + R_ROW,Y
    LDA re : STA Player1 + R_COL,Y
    \ moved: erase the old picture
    LDA rd : CMP OldPos + 1 : BNE moved
    LDA re : CMP OldPos : BEQ same
.moved
    LDA rc : PHA : LDA ra2 : PHA
    JSR erase_old
    PLA : STA ra2 : PLA : STA rc
.same
    LDA rc : STA rd                 ; the view row
    LDA ra2 : STA re                ; the screen column
    \ its heart: it blinks (drawn as floor on even counts)
    LDX pl : LDY prec
    LDA Player1 + R_HEART,Y : BEQ draw
    AND #1 : BNE draw
    LDA TileAttrs : STA sp_attr
    LDA #0
    JMP draw_frame
.draw
    LDA player_colour,X : STA sp_attr
    LDA P1Facing,X : ORA #PIC_PLAYER
    \ (fall into draw_frame)
}

\ &CAF1 DrawFrame: picture A at view row rd, screen column re, in
\ sp_attr. Returns NZ.
.draw_frame
{
    LDX rd : LDY re
    JSR draw_sprite
    LDA #&FF
    RTS
}
.player_colour
    EQUB P1_COLOUR, P2_COLOUR

\ &CC75 EraseOld: floor at the moving player's old position, with the
\ click. &CC79 EraseAt: at map position (rd, re).
.erase_old
    LDA OldPos + 1 : STA rd
    LDA OldPos : STA re
.erase_at
{
    LDA rd : SEC : SBC ViewOrigin : STA rd
    LDA re : SEC : SBC ViewOrigin + 1 : CLC : ADC #VIEW_LEFT : STA re
    LDA TileAttrs : STA sp_attr
    JSR click
    LDA #0
    JMP draw_frame
}

\ &CB0C P1Touch, &CE18: player pl touches its four cells at (rd, re):
\ treasure and strength from what it found, the panel's icons and
\ figures reprinted. NZ when blocked; the exit leaves the level.
.player_touch
{
    LDA rd : PHA : LDA re : PHA
    LDA rd : STA rb : LDA re : STA rc
    LDX prec
    JSR touch_all
    \ the icons: keys, and scrolls
    LDX pl : LDY prec
    LDA Player1 + R_KEYS,Y : STA rl
    LDA icon_row,X : STA rd : LDA #ICON_KEY_COL : STA re
    LDA #ICON_KEY : JSR print_grid
    LDX pl : LDY prec
    LDA Player1 + R_MAGIC,Y : STA rl
    LDA icon_row,X : STA rd : LDA #ICON_SCROLL_COL : STA re
    LDA #ICON_SCROLL : JSR print_grid
    LDA #0 : STA rd
    LDA TouchTreasure : STA re
    JSR add_treasure
    LDA #0 : STA rd
    LDA TouchStrength : STA re
    JSR add_strength
    PLA : STA re : PLA : STA rd
    LDA TouchCode : BEQ done
    CMP #T_EXIT : BNE blocked
    JMP player_exits
.blocked
    LDA #&FF
.done
    RTS
}
.icon_row
    EQUB 5, 13
ICON_KEY_COL = 1
ICON_SCROLL_COL = 4

\ &CB4C ScrollUp, &CB93 ScrollDown, &CBD5 ScrollLeft, &CC23 ScrollRight:
\ slide the view 8 tiles, a tile a step (each a block move of the screen
\ and a new strip), as far as keeps the other player (rh, rl) in its
\ rows or columns 2-20 when both are in play, stopping at the map's edge.
\ The mover is drawn over (erase_old) and drawn next pass. Returns Z
\ when it couldn't, or stopped at the edge.
SCROLL_STEPS = 8
.scroll_up
{
    LDA #SCROLL_STEPS : STA steps
    LDA InPlay : CMP #3 : BNE step
    LDA rh : SEC : SBC #2 : SEC : SBC ViewOrigin
    LSR A : ADC #0 : STA steps
    LDA #SCROLL_STEPS + 1 : SEC : SBC steps : BEQ done
    STA steps
.step
    JSR shift_down
    DEC ViewOrigin : DEC ViewOrigin
    LDA #0 : STA rb : STA rc
    JSR view_strip_row
    LDA ViewOrigin : BEQ done
    DEC steps : BNE step
    JMP erase_old
.done
    RTS
    ZA_AUTO1 steps
}
.scroll_down
{
    LDA #SCROLL_STEPS : STA steps
    LDA InPlay : CMP #3 : BNE step
    LDA rh : SEC : SBC #2 : SEC : SBC ViewOrigin
    LSR A : BEQ done
    STA steps
.step
    JSR shift_up
    INC ViewOrigin : INC ViewOrigin
    LDA #SCREEN_ROWS - 2 : STA rb
    LDA #0 : STA rc
    JSR view_strip_row
    LDA ViewOrigin : CMP #VIEW_MAX : BCS edge
    DEC steps : BNE step
    JMP erase_old
.edge
    LDA #0                          ; (Z)
.done
    RTS
    ZA_AUTO1 steps
}
.scroll_left
{
    LDA #SCROLL_STEPS : STA steps
    LDA InPlay : CMP #3 : BNE step
    LDA rl : SEC : SBC #2 : SEC : SBC ViewOrigin + 1
    LSR A : ADC #0 : STA steps
    LDA #SCROLL_STEPS + 1 : SEC : SBC steps : BEQ done
    STA steps
.step
    JSR shift_right
    DEC ViewOrigin + 1 : DEC ViewOrigin + 1
    LDA #0 : STA rb : STA rc
    JSR view_strip_col
    LDA ViewOrigin + 1 : BEQ done
    DEC steps : BNE step
    JMP erase_old
.done
    RTS
    ZA_AUTO1 steps
}
.scroll_right
{
    LDA #SCROLL_STEPS : STA steps
    LDA InPlay : CMP #3 : BNE step
    LDA rl : SEC : SBC #2 : SEC : SBC ViewOrigin + 1
    LSR A : BEQ done
    STA steps
.step
    JSR shift_left
    INC ViewOrigin + 1 : INC ViewOrigin + 1
    LDA #0 : STA rb
    LDA #SCREEN_ROWS - 2 : STA rc
    JSR view_strip_col
    LDA ViewOrigin + 1 : CMP #VIEW_MAX : BCS edge
    DEC steps : BNE step
    JMP erase_old
.edge
    LDA #0
.done
    RTS
    ZA_AUTO1 steps
}

\ &C574 ViewMapPtr: rhl = the map's tile at the view's origin plus (rb,
\ rc) characters.
.view_cell
{
    LDA ViewOrigin : CLC : ADC rb : STA rb
    LDA ViewOrigin + 1 : CLC : ADC rc : STA rc
    JMP map_cell
}

\ A row of the view's tiles, at view row rb (the strip a vertical scroll
\ uncovers: &CB73-&CB86).
.view_strip_row
{
    LDA rb : PHA
    JSR view_cell
    PLA : STA strip_row
    LDA #VIEW_LEFT : STA strip_col
.next
    LDY #0 : LDA (rhl),Y
    LDX strip_row : LDY strip_col
    JSR draw_cell
    INC rl
    LDA strip_col : CLC : ADC #2 : STA strip_col
    CMP #SCREEN_COLS : BCC next
    RTS
    ZA_AUTO1 strip_row
    ZA_AUTO1 strip_col
}

\ A column of the view's tiles, at view column rc (&CBFC-&CC16).
.view_strip_col
{
    LDA rc : PHA
    JSR view_cell
    PLA : CLC : ADC #VIEW_LEFT : STA strip_col
    LDA #0 : STA strip_row
.next
    LDY #0 : LDA (rhl),Y
    LDX strip_row : LDY strip_col
    JSR draw_cell
    LDA rl : CLC : ADC #32 : STA rl
    BCC c : INC rh
.c
    LDA strip_row : CLC : ADC #2 : STA strip_row
    CMP #SCREEN_ROWS : BCC next
    RTS
    ZA_AUTO1 strip_row
    ZA_AUTO1 strip_col
}
