\ ***************************************************************************
\ The players: their pass, controls, steps, the view's scroll, drawing
\ (&C168-&C1A5, &C967-&CE57; docs/research/players.md). The original has
\ the same code twice, once for each player; here it is once, for the
\ player in pl (0 or 1), its record at Player1 + prec. Positions are (row,
\ column) in characters: (rd, re) is the original's DE, D the row.
\ ***************************************************************************

P1_COLOUR = &45                 ; bright cyan on black (&CAEF)
P2_COLOUR = &44                 ; bright green (&CE13)
PIC_PLAYER = &30                ; the players' pictures: &30 + the facing (&CAED)
THROW_CHIRP = &3C               ; the throw's chirp (&CA29)

\ The controls, per player: magic, up, down, right, left, fire, as BBC
\ internal key numbers (decision 13).
C_MAGIC = 0
C_UP    = 1
C_DOWN  = 2
C_RIGHT = 3
C_LEFT  = 4
C_FIRE  = 5
CONTROLS = 6

\ Set player A's pl and prec. X = pl.
.set_player
{
    STA pl
    TAX : LDA player_rec,X : STA prec
.done
    RTS
}

\ &C168 Player1Pass, &C187 Player2Pass: if player A is in play, its pass;
\ then its code goes into the map under it (&D1A2). A player that leaves by
\ the exit returns from here (player_exits: pass_sp).
.player_pass
{
    JSR set_player
    LDA InPlay : AND in_play_bit,X : BEQ set_player.done
    TSX : STX pass_sp
    JSR player_update
    BNE drawn
    \ not drawn (the view couldn't scroll): the step bit, so it tries again
    LDX pl : LDA P1Facing,X : ORA pass_step_bit,X : STA P1Facing,X
.drawn
    LDX pl : LDY prec
    LDA Player1 + R_ROW,Y : STA rb
    LDA Player1 + R_COL,Y : STA rc
    LDA player_code,X : STA MapStamp
    JMP fill_cells
}
.in_play_bit
    EQUB 1, 2
\ (The original's player 2 sets bits 0 and 1 here, &C195: a facing of
\ right becomes left. Kept.)
.pass_step_bit
    EQUB 1, 3

\ Set the facing (pl's) to A (even), keeping its step bit (&C9BB).
.set_facing
{
    LDX pl
    EOR P1Facing,X : AND #&FE : EOR P1Facing,X   ; (A's bits 1-7, the facing's bit 0)
    STA P1Facing,X
    RTS
}

\ &C967 Diagonal: a right or left facing gains 8 going up, 12 going down.
.diagonal
{
    LDA re : BEQ done
    ASL A                           ; (C set: up, &FF; clear: down, 1)
    LDA #12 : BCC add
    LDA #8
.add
    LDX pl
    CLC : ADC P1Facing,X : STA P1Facing,X
.done
    RTS
}

\ Is player pl's control A held? NZ if so.
.control
{
    LDX pl : BEQ p1
    CLC : ADC #CONTROLS             ; (player 2's follow player 1's)
.p1
    TAY : LDX controls,Y
    JMP key_down
}

\ &C978 Player1Update, &CC98 Player2Update: read the controls, throw or
\ move. Returns NZ when the player was drawn.
.player_update
{
    LDY prec
    LDA Player1 + R_COL,Y : STA OldPos
    LDA Player1 + R_ROW,Y : STA OldPos + 1
    \ frozen: no controls until it runs out
    LDX pl
    LDA P1Frozen,X : BEQ read_controls
    DEC P1Frozen,X
    JMP player_stay
.read_controls
    LDA #0 : STA rd : STA re        ; D: the horizontal step, E: the vertical
    \ magic: a smart bomb a pass while held, while there are any (the
    \ bomb and the view leave DE 0, as the original's alternate set does)
    LDA #C_MAGIC : JSR control : BEQ up
    LDX prec : LDA Player1 + R_MAGIC,X : BEQ up
    DEC Player1 + R_MAGIC,X
    JSR smart_bomb
    JSR draw_view
.up
    LDA #C_UP : JSR control : BEQ down
    LDA #&FF : STA re
    LDA #4 : JSR set_facing
.down
    LDA #C_DOWN : JSR control : BEQ right
    LDA #1 : STA re
    LDA #6 : JSR set_facing
.right
    LDA #C_RIGHT : JSR control : BEQ left
    LDA #1 : STA rd
    LDA #0 : JSR set_facing
    JSR diagonal
.left
    LDA #C_LEFT : JSR control : BEQ fire
    LDA #&FF : STA rd
    LDA #2 : JSR set_facing
    JSR diagonal
.fire
    LDA #C_FIRE : JSR control : BEQ move
    \ fire: throw, if this player's star isn't flying
    LDX pl : LDY star_offset,X
    LDA Star1 + S_THROWER,Y : BNE stay
    \ the power counter: one off, if it isn't 0 (16 bits)
    LDX prec
    LDA Player1 + R_POWER,X : BNE power_lo
    LDA Player1 + R_POWER + 1,X : BEQ no_power
    DEC Player1 + R_POWER + 1,X
.power_lo
    DEC Player1 + R_POWER,X
.no_power
    LDA Player1 + R_BOUNCES,X : STA Bounces
    LDA Player1 + R_ROW,X : STA rb
    LDA Player1 + R_COL,X : STA rc
    LDX pl : LDA P1Facing,X
    JSR launch_star
    LDA #THROW_CHIRP : JSR chirp
.stay
    JMP player_stay
.move
    \ &CA31: no direction, no move
    LDA rd : ORA re : BEQ stay
    LDA re : STA StepV              ; the vertical step
    LDA rd : STA StepH              ; ... and the horizontal
    \ lift the player out of the map (its cells at the start of the pass,
    \ where it is)
    LDA OldPos + 1 : STA rb : STA rd
    LDA OldPos : STA rc : STA re
    LDA #0 : STA MapStamp
    JSR fill_cells
    \ a new facing clears the step bit: a turn takes a pass
    LDX pl
    LDA P1LastFacing,X : EOR P1Facing,X : AND #&FE : BEQ same
    LSR P1Facing,X : ASL P1Facing,X     ; (bit 0 cleared)
.same
    LDA P1Facing,X : STA P1LastFacing,X
    \ step when the step bit was set, and toggle it
    AND #1 : BEQ toggle
    LDA re : CLC : ADC StepH : STA re
    LDA rd : CLC : ADC StepV : STA rd
.toggle
    LDA P1Facing,X : EOR #1 : STA P1Facing,X
    JSR player_touch : BEQ player_place
    \ blocked: the step bit set, and slide: the horizontal step alone,
    \ then the vertical (a touch leaves the facing alone)
    LDX pl : LDA P1Facing,X : ORA #1 : STA P1Facing,X
    LDY prec
    LDA Player1 + R_ROW,Y : STA rd
    LDA Player1 + R_COL,Y : CLC : ADC StepH : STA re
    JSR player_touch : BEQ player_place
    LDY prec
    LDA Player1 + R_ROW,Y : CLC : ADC StepV : STA rd
    LDA Player1 + R_COL,Y : STA re
    JSR player_touch : BEQ player_place
    \ (fall into player_stay)
}

\ &CAA6 P1Stay: not moving: its position as it was.
.player_stay
{
    LDY prec
    LDA Player1 + R_ROW,Y : STA rd
    LDA Player1 + R_COL,Y : STA re
    \ (fall into player_place)
}

\ &CAAA P1Place, &CDCE: player pl to (rd, re): scroll the view if that's
\ outside the view's rows and columns 2-20, else store it, erase the old
\ picture if it moved, and draw. NZ when drawn.
.player_place
{
    ZA_AUTO1 column
    \ the other player's position, for the scroll (H its row, L its column)
    LDA prec : EOR #R_SIZE : TAY
    LDA Player1 + R_ROW,Y : STA rh
    LDA Player1 + R_COL,Y : STA rl
    LDA rd : SEC : SBC ViewOrigin : STA rc
    LDX #SCROLL_DOWN : CMP #PLACE_MAX + 1 : BCS scroll
    LDX #SCROLL_UP : CMP #PLACE_MIN : BCC scroll
    LDA re : SEC : SBC ViewOrigin + 1
    LDX #SCROLL_RIGHT : CMP #PLACE_MAX + 1 : BCS scroll
    LDX #SCROLL_LEFT : CMP #PLACE_MIN : BCC scroll
    \ in the view
    ADC #VIEW_LEFT - 1 : STA column ; the screen column (C set: from PLACE_MIN)
    LDY prec
    LDA re : STA Player1 + R_COL,Y
    LDA rd : STA Player1 + R_ROW,Y
    \ moved: erase the old picture
    CMP OldPos + 1 : BNE moved
    LDA re : CMP OldPos : BEQ same
.moved
    JSR erase_old                   ; (which keeps rc)
.same
    LDA rc : STA rd                 ; the view row
    LDA column : STA re             ; the screen column
    \ its heart: it blinks (drawn as floor on even counts)
    LDX pl : LDY prec
    LDA Player1 + R_HEART,Y : BEQ draw
    LSR A : BCS draw
    JMP draw_floor_frame
.draw
    LDA player_colour,X : STA sp_attr
    LDA P1Facing,X : ORA #PIC_PLAYER
    \ (fall into draw_frame)
}

\ &CAF1 DrawFrame: picture A at view row rd, screen column re, in
\ sp_attr. Returns NZ.
.draw_frame
{
    LDX rd : LDY re
    JSR draw_sprite
    LDA #&FF
    RTS
}
.player_colour
    EQUB P1_COLOUR, P2_COLOUR

\ &CB4C ScrollUp, &CB93 ScrollDown, &CBD5 ScrollLeft, &CC23 ScrollRight:
\ slide the view 8 tiles, a tile a step (each a block move of the screen
\ and a new strip), as far as keeps the other player (rh, rl) in its
\ rows or columns 2-20 when both are in play, stopping at the map's edge.
\ The mover is drawn over (erase_old) and drawn next pass. Returns Z
\ when it couldn't, or stopped at the edge. The original's four differ
\ only in the axis, the way along it and the shift: here they are one,
\ for direction X, the differences in the scroll_ tables.
SCROLL_STEPS = 8
SCROLL_DOWN  = 0                    ; (bit 0: the axis, ViewOrigin's row or column;
SCROLL_RIGHT = 1                    ; bit 1: back, towards the map's top or left)
SCROLL_UP    = 2
SCROLL_LEFT  = 3
.scroll
{
    STX dir
    TXA : AND #1 : STA axis
    LDA #SCROLL_STEPS : STA steps
    LDA InPlay : CMP #3 : BNE step
    \ the other player's row (rh) or column (rl), less 2, less the view's,
    \ halved: the steps forward; back, 9 less that rounded up
    LDY axis : TYA : EOR #1 : TAX   ; (the Z80's pairs: the column first)
    LDA rl,X : SEC : SBC #2 : SEC : SBC ViewOrigin,Y
    LSR A
    LDX dir : LDY scroll_delta,X : BPL forward  ; (C kept)
    ADC #0 : STA steps
    LDA #SCROLL_STEPS + 1 : SEC : SBC steps
.forward
    TAY : BEQ done                  ; (Z from A again: the LDY set it)
    STA steps
.step
    LDX dir : LDA scroll_shift,X : TAX
    JSR shift_by
    LDX dir : LDY axis
    LDA ViewOrigin,Y : CLC : ADC scroll_delta,X : STA ViewOrigin,Y
    \ the strip uncovered: a row for a vertical scroll, a column across
    TYA : EOR #1 : TAY
    LDA scroll_strip,X
    JSR view_strip
    \ the edge: going forward, ViewOrigin at VIEW_MAX or past it; back, at
    \ 0 (flipped, &FF)
    LDX dir : LDY axis
    LDA ViewOrigin,Y : EOR scroll_flip,X : CMP scroll_edge,X : BCS edge
    DEC steps : BNE step
    BEQ erase_old                   ; (always)
.edge
    LDA #0                          ; (Z)
.done
    RTS
    ZA_AUTO1 dir
    ZA_AUTO1 axis
    ZA_AUTO1 steps
}
\ By direction: down, right, up, left.
.scroll_shift                       ; the screen's shift (shift_by's program)
    EQUB prog_up - shift_progs, prog_left - shift_progs, prog_down - shift_progs, prog_right - shift_progs
.scroll_delta                       ; ViewOrigin's step: a tile
    EQUB 2, 2, -2, -2
.scroll_strip                       ; where the strip uncovered is, in the view
    EQUB SCREEN_ROWS - 2, SCREEN_ROWS - 2, 0, 0
.scroll_flip
    EQUB 0, 0, &FF, &FF
.scroll_edge
    EQUB VIEW_MAX, VIEW_MAX, &FF, &FF
\ &CC75 EraseOld: floor at the moving player's old position, with the
\ click. &CC79 EraseAt: at map position (rd, re).
.erase_old
    LDA OldPos + 1 : STA rd
    LDA OldPos : STA re
.erase_at
    LDA rd : SEC : SBC ViewOrigin : STA rd
    LDA re : SEC : SBC ViewOrigin + 1 : CLC : ADC #VIEW_LEFT : STA re
    JSR click
    \ (fall into draw_floor_frame)
\ Floor at view row rd, screen column re.
.draw_floor_frame
    LDA TileAttrs : STA sp_attr
    LDA #0
    JMP draw_frame

\ &CB0C P1Touch, &CE18: player pl touches its four cells at (rd, re):
\ treasure and strength from what it found, the panel's icons and
\ figures reprinted. NZ when blocked; the exit leaves the level.
.player_touch
{
    LDA rd : STA rb : PHA
    LDA re : STA rc : PHA
    JSR touch_all
    \ the icons: keys, and scrolls
    LDY #R_KEYS : LDX #ICON_KEY : LDA #ICON_KEY_COL : JSR print_icons
    LDY #R_MAGIC : LDX #ICON_SCROLL : LDA #ICON_SCROLL_COL : JSR print_icons
    LDA #0 : STA rd
    LDA TouchTreasure : STA re
    JSR add_treasure
    LDA TouchStrength : STA re      ; (add_treasure keeps rd 0)
    JSR add_strength
    PLA : STA re : PLA : STA rd
    LDA TouchCode : BEQ done
    CMP #T_EXIT : BNE blocked
    JMP player_exits
.blocked
    LDA #&FF
.done
    RTS
}
.icon_row
    EQUB 5, 13
ICON_KEY_COL = 1
ICON_SCROLL_COL = 4

\ &C574 ViewMapPtr: rhl = the map's tile at the view's origin plus (rb,
\ rc) characters.
.view_cell
{
    LDA ViewOrigin : CLC : ADC rb : STA rb
    LDA ViewOrigin + 1 : CLC : ADC rc : STA rc
    JMP map_cell
}

\ A line of the view's tiles, for the strip a scroll uncovers: a row
\ (&CB73-&CB86) at view row A (Y = 1), or a column (&CBFC-&CC16) at view
\ column A (Y = 0). Y indexes the Z80's pairs (rc, rb: the column first),
\ and pos in the same order.
.view_strip
{
    LDX #0 : STX rc : STX rb : STX pos + 1  ; (the screen's row 0)
    LDX #VIEW_LEFT : STX pos                ; (the view's column 0)
    STA rc,Y
    CLC : ADC pos,Y
    ZA_INDEXEDBY 0..1
    STA pos,Y
    ZA_INDEXEDBY 0..1
    TYA : EOR #1 : STA along        ; a row runs along the columns, a column along the rows
    JSR view_cell
.next
    LDY #0 : LDA (rhl),Y
    LDX pos + 1 : LDY pos
    JSR draw_cell
    LDX along
    LDA rl : CLC : ADC map_step,X : STA rl
    BCC c : INC rh
.c
    LDA pos,X
    ZA_INDEXEDBY 0..1
    CLC : ADC #2 : STA pos,X
    ZA_INDEXEDBY 0..1
    CMP pos_end,X : BCC next
    RTS
    ZA_AUTO 2, pos                  ; the screen's column and row
    ZA_AUTO1 along
}
.map_step                           ; along the columns, then the rows
    EQUB 1, 32
.pos_end
    EQUB SCREEN_COLS, SCREEN_ROWS
