\ ***************************************************************************
\ The status: strength and treasure, the panel's figures and icons, the
\ status tick every 25 passes, the timers, and the game's and the level's
\ resets (&C121, &D9EC-&DBE7; docs/research/core.md).
\ ***************************************************************************

STATUS_EVERY = 25               ; passes between status ticks (&D9F4)
IDLE_TICKS   = 100              ; status ticks in an idle period (&DA34, &DB4D)
IDLE_STAGES  = 4                ; idle periods until the walls open (&DB52)
T_BORDER_LO  = &04              ; the border walls' codes, &04 and &05 (&DA45)
T_BORDER_HI  = &06
T_ONE_WALL   = &07              ; a closed one-way tile (&DA6F)
ICON_KEY     = &22              ; the panel's key and scroll icons (&CB19, &CB24)
ICON_SCROLL  = &23

\ &C121 Timers: count down the five per-pass timers that aren't 0.
.timers
{
    LDY #TIMERS - 1
.next
    LDX timer_index,Y
    LDA vars_ba,X : BEQ zero
    DEC vars_ba,X
.zero
    DEY : BPL next
    RTS
}
TIMERS = 5
.timer_index
    EQUB P1Skull - vars_ba, P2Skull - vars_ba, FreezeTimer - vars_ba, P1Heart - vars_ba, P2Heart - vars_ba

\ &D9EC StatusTick: every 25 passes, the music's restart, a strength off
\ each player in play, the one-way tiles, and the idle timer: when no
\ treasure has been taken for a period, every key, door and chest goes;
\ after the fourth, the border walls become exits.
.status_tick
{
    DEC StatusPasses : BNE done
    LDA #STATUS_EVERY : STA StatusPasses
    JSR music_restart
    LDA #0
.drain
    JSR set_player
    LDA InPlay : AND in_play_bit,X : BEQ next
    LDA #&FF : STA rd : STA re      ; (DE = -1)
    JSR add_strength
.next
    LDA pl : EOR #1 : BNE drain     ; (player 1, then player 2)
    JSR close_one_ways
    DEC IdleTicks : BNE done
    \ keys, doors and chests (&08-&0B) go
    LDA #T_KEY : LDX #T_CHEST : LDY #0
    JSR replace_codes
    LDA #IDLE_TICKS : STA IdleTicks
    DEC IdleStage : BNE done
    \ the walls open
    LDA #T_BORDER_LO : LDX #T_BORDER_HI : LDY #T_EXIT
    JSR replace_codes
.done
    RTS
}

\ Every map code from A up to X (not including it) becomes Y, and is
\ redrawn (&DA1D, &DA41).
.replace_codes
{
    STA lo : STX hi : STY new
    LDA #LO(map) : STA rl : LDA #HI(map) : STA rh
.next
    LDY #0 : LDA (rhl),Y
    CMP lo : BCC skip
    CMP hi : BCS skip
    LDA new : STA (rhl),Y
    JSR redraw_cell
.skip
    INC rl : BNE next
    INC rh : LDA rh : CMP #HI(map) + 4 : BNE next
    RTS
    ZA_AUTO1 lo
    ZA_AUTO1 hi
    ZA_AUTO1 new
}

\ &DA59 CloseOneWays: each one-way tile walked through (OneWays) becomes a
\ wall (&07) once its cell is empty again.
.close_one_ways
{
    LDX #0
.next
    LDA OneWays,X : BEQ skip
    SEC : SBC #ZX_MAP_HI - HI(map) : STA rh  ; (the original's address, kept: take_one_way)
    LDA OneWays + 1,X : STA rl
    LDY #0 : LDA (rhl),Y : BNE skip
    STA OneWays,X : STA OneWays + 1,X
    LDA #T_ONE_WALL : STA (rhl),Y
    TXA : PHA
    JSR redraw_cell
    PLA : TAX
.skip
    INX : INX : CPX #2 * ONE_WAYS : BNE next
    RTS
}

\ Player pl's icons for the count at field Y of its record: icon X, from
\ column A of its icon row (&CB0C's).
.print_icons
    STA re
    TYA : CLC : ADC prec : TAY
    LDA Player1,Y : STA rl
    LDY pl : LDA icon_row,Y : STA rd
    TXA
    \ (fall into print_grid)

\ &DA7E PrintGrid: the panel's icons, a 3 x 3 grid from row rd, column re:
\ A's character as many times as the count (rl), then spaces.
.print_grid
{
    STA icon
    INC rl
    LDA #3 : STA grid_rows
.row
    LDA rd : STA PrintPos + 1
    ASL A : ASL A : ASL A : ORA re : TAX    ; (panel_shown's index)
    LDA #3 : STA grid_cols
.col
    DEC rl : BNE draw
    LDA #' ' : STA icon             ; (spaces from there on: the count wraps past 0)
.draw
    \ print_char's, unless the cell shows it (panel_print)
    LDA icon
    CMP panel_shown,X : BEQ shown
    JSR panel_print
.shown
    INX
    DEC grid_cols : BNE col
    INC rd
    DEC grid_rows : BNE row
    LDA re : CLC : ADC #3 : STA PrintPos    ; (as print_char leaves it)
    RTS
    ZA_AUTO1 icon
    ZA_AUTO1 grid_rows
    ZA_AUTO1 grid_cols
}
    ASSERT ICON_SCROLL_COL + 3 <= PANEL_COLS

\ The figures and icons are reprinted on every touch, up to three times a
\ pass, and mostly show what they did. print_char skips a panel cell
\ that shows its character already (decision 22); print_grid and print5
\ make the same check before calling it, along a row of the panel by
\ panel_shown's index (row * PANEL_COLS + column) in X, and set the
\ cursor only when print_char needs it and at the end.
\ print_char for A at the panel cell X, the cursor's column from X. X is
\ kept.
.panel_print
    STX put_at
    PHA : TXA : AND #PANEL_COLS - 1 : STA PrintPos : PLA
    JSR print_char
    LDX put_at
    RTS
    ASSERT PANEL_COLS = 8
ZA_AUTO1 put_at

\ &DAA6 P1AddStrength, &DAF4 P2AddStrength: add DE (rd, re: high, low) to
\ player pl's strength, and print it. Not while its heart runs; with its
\ shield, one change in four (random AND &0C = 0) is skipped. Below 0, the
\ player is out of play: game over for it.
.add_strength
{
    LDX prec
    LDA Player1 + R_HEART,X : BNE done
    LDA Player1 + R_ARMOUR,X : BEQ apply
    JSR random : AND #&0C : BEQ done    ; (random keeps X)
.apply
    LDA Player1 + R_STRENGTH,X : CLC : ADC re : STA rl
    LDA Player1 + R_STRENGTH + 1,X : ADC rd : STA rh
    BPL set_strength
    \ (dead)
    \ out of play (InPlay's bits 0 and 2, or 1 and 3, cleared), its cells
    \ cleared, strength shown as 0, song 2, game over
    LDX pl
    LDA InPlay : AND dead_keep,X : STA InPlay
    LDY prec
    LDA Player1 + R_ROW,Y : STA rb
    LDA Player1 + R_COL,Y : STA rc
    LDA #0 : STA MapStamp
    JSR fill_cells
    STA rl : STA rh                 ; (A = 0: fill_cells leaves MapStamp in it)
    JSR set_strength
    LDA #SONG_DEAD : JSR play_song
    JMP game_over
.done
    RTS
}
.dead_keep
    EQUB &0A, &05
SONG_DEAD = 2

\ &DAE8 P1SetStrength, &DB33: player pl's strength = rhl, printed.
.set_strength
{
    LDX prec
    LDA rl : STA Player1 + R_STRENGTH,X
    LDA rh : STA Player1 + R_STRENGTH + 1,X
    LDX pl
    LDA strength_row,X
    JMP print5_at
}
.strength_row
    EQUB 2, 10

\ &DB3F P1AddTreasure, &DB59: add DE to player pl's treasure, print it,
\ and start the idle timers again.
.add_treasure
{
    LDX prec
    LDA Player1 + R_TREASURE,X : CLC : ADC re : STA Player1 + R_TREASURE,X : STA rl
    LDA Player1 + R_TREASURE + 1,X : ADC rd : STA Player1 + R_TREASURE + 1,X : STA rh
    LDA #IDLE_TICKS : STA IdleTicks
    LDA #IDLE_STAGES : STA IdleStage
    LDX pl
    LDA treasure_row,X
    \ (fall into print5_at)
}
\ Print rhl as 5 digits at row A, column 1 (the panel's figures).
.print5_at
    STA PrintPos + 1
    LDA #1 : STA PrintPos
    \ (fall into print5)

\ &DB71 Print5Digits: rhl as 5 digits at the print position. (The panel's
\ sixth digit is a 0 in the loading screen: the figures show ten times
\ their value.) &DB83 Print2Digits: its last two. The digits are kept
\ for each of the panel's four figures (a slot by the print row's bits 2
\ and 3), with the value they are, as a memo: the division is most of a
\ figure's cost, and it mostly shows the same value again (panel_print).
.print5
{
    LDA PrintPos + 1 : LSR A : LSR A : AND #P5_SLOTS - 1 : STA slot
    TAY
    LDA rl : CMP p5_lo,Y : BNE divide
    LDA rh : CMP p5_hi,Y : BEQ print
.divide
    LDA rl : STA p5_lo,Y
    LDA rh : STA p5_hi,Y
    LDX #4
.digit
    LDA #'0' : STA ch
.sub
    LDA rl : SEC : SBC tens_lo,X : TAY
    LDA rh : SBC tens_hi,X : BCC keep
    STA rh : STY rl
    INC ch
    BCS sub                         ; (always: no borrow)
.keep
    TXA : ASL A : ASL A : ORA slot : TAY
    LDA ch : STA p5_digits,Y
    DEX : BPL digit
.print
    \ the digits, the ten thousands' first, as print_grid's icons (the
    \ menu's high score, not in the panel, each by print_char)
    LDA slot : ORA #4 * P5_SLOTS : STA slot
    LDA PrintPos : CMP #PANEL_COLS : BCS outside
    LDA PrintPos + 1 : ASL A : ASL A : ASL A : ORA PrintPos : TAX   ; (panel_shown's index)
.next
    LDY slot : LDA p5_digits,Y
    CMP panel_shown,X : BEQ shown
    JSR panel_print
.shown
    INX
    LDA slot : SEC : SBC #P5_SLOTS : STA slot : BCS next
    TXA : AND #PANEL_COLS - 1 : STA PrintPos    ; (as print_char leaves it)
    BPL done                        ; (always)
.outside
    LDY slot : LDA p5_digits,Y
    JSR print_char
    LDA slot : SEC : SBC #P5_SLOTS : STA slot : BCS outside
.done
    LDA #0 : STA rl : STA rh        ; (as the division leaves them)
    RTS                             ; (A = 0: &DB8F: XOR A, which the monsters' hit relies on)
    ZA_AUTO1 ch
    ZA_AUTO1 slot
}
P5_SLOTS = 4
\ print5's values, and their digits (digit k of slot s at 4k + s, k = 0
\ the units): 0, which they are
.p5_lo
    EQUB 0, 0, 0, 0
.p5_hi
    EQUB 0, 0, 0, 0
.p5_digits
    FOR k = 1..5 * P5_SLOTS : EQUB '0' : NEXT
.treasure_row
    EQUB 4, 12
.tens_lo
    EQUB LO(1), LO(10), LO(100), LO(1000), LO(10000)
.tens_hi
    EQUB HI(1), HI(10), HI(100), HI(1000), HI(10000)

\ &DBA2 ResetGame: zero the scores and the game's counts, then the level's.
.reset_game
{
    LDA #0
    LDX #R_ARMOUR - R_TREASURE - 1
.scores
    STA Player1 + R_TREASURE,X : STA Player2 + R_TREASURE,X     ; treasure, strength, power
    DEX : BPL scores
    \ the password typed, and the keys and scrolls (and the bounces and
    \ rings after them, which reset_level clears anyway)
    LDX #PASSWORD_LEN - 1
.counts
    STA PasswordTyped,X : STA P1Keys,X : STA P2Keys,X
    DEX : BPL counts
    \ (fall into reset_level)
}
    ASSERT R_KEYS + PASSWORD_LEN - 1 = R_RING AND R_RING < R_SIZE
\ &DBCA ResetLevel: the level's counts, and the one-way tiles' list.
.reset_level
{
    LDA #0
    STA P1Bounces : STA P2Bounces : STA P1Armour : STA P2Armour : STA P1Ring : STA P2Ring
    LDX #2 * ONE_WAYS - 1
.clear
    STA OneWays,X
    DEX : BPL clear
    RTS
}
