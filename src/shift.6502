\ ***************************************************************************
\ The playfield's shifts, a tile (16 pixels) at a time, for the scroll:
\ the original's ShiftLeft (&DBE8), ShiftRight (&DC17), ShiftUp (&DC48)
\ and ShiftDown (&DC7F), pixels and attributes. The strip they leave is
\ redrawn by the scroll.
\ ***************************************************************************

PF_OFFSET  = VIEW_LEFT * 16     ; a character row's playfield, from its start
PF_BYTES   = ROW_BYTES - PF_OFFSET
TILE_BYTES = 32                 ; a tile's width in a character row's bytes
PF_COLS    = SCREEN_COLS - VIEW_LEFT
    ASSERT ROW_BYTES = &200 AND PF_OFFSET < &100

\ The copier, for speed (decision 22): a LDA abs,Y : STA abs,Y for each
\ character row, the rows' addresses written into it (cp_set), and Y
\ stepped across the rows' bytes, so a byte costs little more than its
\ load and store. A shift is three runs of it: the pixels in the first
\ page of each row's playfield and in the second (the same rows a page
\ on or back, cp_page), then the attributes. Within a run the rows go in
\ the order cp_set gave them, so a row is read before it's written over.
CP_PAIRS = SCREEN_ROWS
OP_INY = &C8
OP_DEY = &88
OP_INC_ABSX = &FE
OP_DEC_ABSX = &DE

\ cp_set's: the first row's source and destination, and the step from
\ one row's to the next (words, as a shift's program has them)
ZA_AUTO 6, cp_par
CP_SRC = 0
CP_DST = 2
CP_STRIDE = 4
ZA_AUTO2 sh_at                  ; shift_by's program
ZA_AUTO1 sh_i                   ; ... and the next byte in it

\ Run the copier from Y, stepping Y (INY or DEY) until it's the end.
.cp_go
    JMP cp_pairs                ; (cp_set: the first row in use)
.cp_pairs
FOR k = 0..CP_PAIRS - 1
    LDA &FFFF,Y : STA &FFFF,Y
NEXT
.cp_step
    INY                         ; (or DEY: shift_by)
.cp_end
    CPY #0                      ; (the end: shift_by)
    BEQ cp_done
.cp_loop
    JMP cp_pairs                ; (as cp_go)
.cp_done
    RTS

\ The copier's rows: the last A of its CP_PAIRS, from cp_par's source
\ and destination, each the last's plus its stride.
.cp_set
{
    EOR #&FF : SEC : ADC #CP_PAIRS  ; CP_PAIRS - A, the first in use
    STA first : ASL A : ADC first : ASL A : TAX     ; (C clear: under 128)
    ADC #LO(cp_pairs) : STA cp_go + 1 : STA cp_loop + 1
    LDA #HI(cp_pairs) : ADC #0 : STA cp_go + 2 : STA cp_loop + 2
.pair
    LDA cp_par + CP_SRC : STA cp_pairs + 1,X : CLC : ADC cp_par + CP_STRIDE : STA cp_par + CP_SRC
    LDA cp_par + CP_SRC + 1 : STA cp_pairs + 2,X : ADC cp_par + CP_STRIDE + 1 : STA cp_par + CP_SRC + 1
    LDA cp_par + CP_DST : STA cp_pairs + 4,X : CLC : ADC cp_par + CP_STRIDE : STA cp_par + CP_DST
    LDA cp_par + CP_DST + 1 : STA cp_pairs + 5,X : ADC cp_par + CP_STRIDE + 1 : STA cp_par + CP_DST + 1
    TXA : CLC : ADC #6 : TAX
    CPX #6 * CP_PAIRS : BNE pair
    RTS
    ZA_AUTO1 first
}

\ A shift, from its program at X:A (SHIFT_PROGRAM): the pixels' rows, the
\ first run, the second a page on or back, then the attributes' rows and
\ their run.
.shift_by
{
    STA sh_at : STX sh_at + 1
    LDA #0 : STA sh_i
    JSR rows
    JSR run
    JSR next : STA inc1 : STA inc2      ; (INC or DEC abs,X)
    LDX #6 * (CP_PAIRS - 1)
.page
.inc1
    INC cp_pairs + 2,X
.inc2
    INC cp_pairs + 5,X
    TXA : SEC : SBC #6 : TAX
    BCS page
    JSR run
    JSR rows
    \ (fall into run)
.run
    JSR next : STA cp_step
    JSR next : STA cp_end + 1
    JSR next : TAY
    JMP cp_go
.rows
    LDX #0
    ZA_DISCARD cp_par
.param
    JSR next : STA cp_par,X
    ZA_INDEXEDBY 0..5
    INX : CPX #6 : BNE param
    JSR next
    JMP cp_set
.next
    LDY sh_i : INC sh_i
    LDA (sh_at),Y
    RTS
}

\ A shift's program for shift_by: the pixels' rows (the first row's
\ source and destination, the step to the next, how many), a run of the
\ first page (Y's start, end, INY or DEY), INC or DEC for the second
\ page, its run; then the attributes' rows and their run.
MACRO CP_ROWS src, dst, stride, n
    EQUW src, dst, stride AND &FFFF
    EQUB n
ENDMACRO
MACRO CP_RUN from, to, op
    IF op = OP_INY
        EQUB op, LO(to + 1), from
    ELSE
        EQUB op, LO(to - 1), from
    ENDIF
ENDMACRO

\ &DBE8 ShiftLeft: columns 10-31 to 8-29. Each row's bytes a tile back,
\ from the left (the first page, then the second).
.shift_left
    LDA #LO(prog_left) : LDX #HI(prog_left) : JMP shift_by
.prog_left
    CP_ROWS screen, screen - TILE_BYTES, ROW_BYTES, SCREEN_ROWS
    CP_RUN PF_OFFSET + TILE_BYTES, &FF, OP_INY
    EQUB OP_INC_ABSX
    CP_RUN 0, &FF, OP_INY
    CP_ROWS attrs + VIEW_LEFT + 2, attrs + VIEW_LEFT, SCREEN_COLS, SCREEN_ROWS
    CP_RUN 0, PF_COLS - 3, OP_INY

\ &DC17 ShiftRight: columns 8-29 to 10-31: from the right (the second
\ page, then the first), each from its last byte.
.shift_right
    LDA #LO(prog_right) : LDX #HI(prog_right) : JMP shift_by
.prog_right
    CP_ROWS screen + &100, screen + &100 + TILE_BYTES, ROW_BYTES, SCREEN_ROWS
    CP_RUN &FF - TILE_BYTES, 0, OP_DEY
    EQUB OP_DEC_ABSX
    CP_RUN &FF, PF_OFFSET, OP_DEY
    CP_ROWS attrs + VIEW_LEFT, attrs + VIEW_LEFT + 2, SCREEN_COLS, SCREEN_ROWS
    CP_RUN PF_COLS - 3, 0, OP_DEY

\ &DC48 ShiftUp: rows 2-23 to 0-21, from the top.
.shift_up
    LDA #LO(prog_up) : LDX #HI(prog_up) : JMP shift_by
.prog_up
    CP_ROWS screen + 2 * ROW_BYTES, screen, ROW_BYTES, SCREEN_ROWS - 2
    CP_RUN PF_OFFSET, &FF, OP_INY
    EQUB OP_INC_ABSX
    CP_RUN 0, &FF, OP_INY
    CP_ROWS attrs + 2 * SCREEN_COLS + VIEW_LEFT, attrs + VIEW_LEFT, SCREEN_COLS, SCREEN_ROWS - 2
    CP_RUN 0, PF_COLS - 1, OP_INY

\ &DC7F ShiftDown: rows 0-21 to 2-23, from the bottom.
.shift_down
    LDA #LO(prog_down) : LDX #HI(prog_down) : JMP shift_by
.prog_down
    CP_ROWS screen + (SCREEN_ROWS - 3) * ROW_BYTES, screen + (SCREEN_ROWS - 1) * ROW_BYTES, -ROW_BYTES, SCREEN_ROWS - 2
    CP_RUN PF_OFFSET, &FF, OP_INY
    EQUB OP_INC_ABSX
    CP_RUN 0, &FF, OP_INY
    CP_ROWS attrs + (SCREEN_ROWS - 3) * SCREEN_COLS + VIEW_LEFT, attrs + (SCREEN_ROWS - 1) * SCREEN_COLS + VIEW_LEFT, -SCREEN_COLS, SCREEN_ROWS - 2
    CP_RUN 0, PF_COLS - 1, OP_INY
