\ ***************************************************************************
\ The map's cells: the original's helpers (&D117, &D181, &D18A-&D1B9,
\ &D267, &D521, &D569). A position is (row, column) in characters, two to
\ a tile each way; the map is 32 x 32 tiles, page-aligned (map).
\ ***************************************************************************

\ &D569 MapCell: rhl = the map's tile at (rb, rc); A = its code, Z if
\ empty. Y = 0; X is kept. (Rows wrap within the map's 32, as the
\ original's do.) hi_nibble and lo_nibble (tables.6502) give rb's top and
\ bottom nibbles without shifts: each holds its nibble in both halves.
.map_cell
{
    LDY rb
    LDA lo_nibble,Y : AND #&E0 : STA rl         ; (the tile row's low three bits, times 32)
    LDA hi_nibble,Y : AND #3
    CLC : ADC #HI(map) : STA rh                 ; (its top two)
    LDA rc : LSR A : AND #&1F : ORA rl : STA rl
    LDY #0 : LDA (rhl),Y
    RTS
}

\ &D117 CellPos: the position (rb, rc) of the map tile at rhl. X is kept.
\ (rh past the map, as the scan's reach of map_tail gives, takes its low
\ two bits only, as a 16-bit shift and the AND of rows would.)
.cell_pos
{
    LDA rl : ASL A : AND #&3E : STA rc
    LDY rl : LDA hi_nibble,Y : AND #&0E : STA rb    ; (the tile row's low three bits)
    LDY rh : LDA lo_nibble - HI(map),Y : AND #&30   ; (its top two)
    ORA rb : STA rb
    RTS
}

\ The position (rb, rc) of the monster whose head is at rhl: its tile's,
\ and code_offset. code_offset: from its tile's position, the cell its
\ code's bits 0-1 say it starts at (bit 1 down, bit 0 right). Y = 0.
.head_pos
    JSR cell_pos
.code_offset
{
    LDY #0 : LDA (rhl),Y
    LSR A : BCC down : INC rc
.down
    LSR A : BCC done : INC rb
.done
    RTS
}

\ &D1A2 FillCells: MapStamp into the four cells at (rb, rc): (rb, rc),
\ (rb+1, rc), (rb+1, rc+1), (rb, rc+1). rc comes back one more. A cell in
\ a tile already stamped is skipped (the same again would change
\ nothing): the cells below are in the same tiles when rb is even, the
\ cells to the right when rc is even.
.fill_cells
{
    LDA rb : LSR A : BCC fill_pair  ; (rb even: the row below's tiles are these)
    INC rb : JSR fill_pair
    DEC rc : DEC rb
    \ (fall into fill_pair)
}
\ MapStamp into (rb, rc) and (rb, rc+1); rc comes back one more. rhl is
\ the last cell's tile, Y = 0 and A = MapStamp, as fill_cell leaves them.
.fill_pair
{
    JSR fill_cell
    INC rc
    LDA rc : LSR A : BCC fill_cell  ; (rc+1 even: a tile of its own)
    LDA MapStamp
    RTS
}
\ &D1B2
.fill_cell
{
    JSR map_cell
    LDA MapStamp : STA (rhl),Y
    RTS
}

\ &D18A CellsEmpty: are the four cells at (rb, rc) empty? Z if so; else
\ NZ with A the first non-empty one's code. rc comes back one more (when
\ all are empty).
.cells_empty
{
    JSR map_cell : BNE done
    INC rb : JSR map_cell : BNE done
    INC rc : JSR map_cell : BNE done
    DEC rb : JSR map_cell
.done
    RTS
}

\ &D521 CellsFree: as cells_empty, but rc comes back as it was when all
\ four are empty.
.cells_free
{
    JSR cells_empty : BNE done
    DEC rc
    LDA #0
.done
    RTS
}

\ &D181 RedrawCell: redraw the map tile at rhl, if it's in view.
.redraw_cell
{
    LDA rb : PHA : LDA rc : PHA                 ; (cell_pos sets BC: the original's callers keep their own)
    JSR cell_pos
    JSR redraw_tile                             ; (which keeps rhl)
    PLA : STA rc : PLA : STA rb
    RTS
}

\ &D267 RedrawTile: redraw the map tile at rhl, whose position is (rb,
\ rc), if it's in the view. (draw_cell keeps rb, rc and rhl, which the
\ original pushes round it.)
.redraw_tile
{
    LDA rb : SEC : SBC ViewOrigin
    CMP #SCREEN_ROWS : BCS done
    AND #&1E : TAX
    LDA rc : SEC : SBC ViewOrigin+1
    CMP #SCREEN_ROWS : BCS done                 ; (the view is 24 characters square)
    AND #&1E : ADC #VIEW_LEFT : TAY             ; (C clear: in the view)
    STY ra2
    LDY #0 : LDA (rhl),Y
    LDY ra2
    JMP draw_cell
.done
    RTS
}
