\ ***************************************************************************
\ NINJA MASSACRE for the BBC Micro - build file
\
\ !BOOT runs NINJA, which loads at &1900 and runs there. (This is the first
\ layer: the screen. The layout grows as the game does: docs/journal.md.)
\ ***************************************************************************

INCLUDE "defs.6502"

DATA_MAGIC = "NDATA"

\ The build stamp comes from the Makefile (-D BUILD="date time sha"), so a
\ disc says what it is: *TYPE !BOOT shows it. A + after the sha means the
\ tree had uncommitted changes.
IF DEFINED(BUILD)
    build_stamp = BUILD
ELSE
    build_stamp = "DEV"
ENDIF

SECTION Boot, filename = "!BOOT", exec = &FFFFFFFF
    EQUS "*| NINJA MASSACRE ", build_stamp, 13
    EQUS "*RUN NLOAD", 13
ENDSECTION

\ The loader (loader.6502): NDATA into a sideways RAM bank, then NINJA. It
\ runs from where MODE 7 leaves free, above anything it loads.
SECTION Loader, org = &7000, load = &FFFF7000, exec = &FFFF0000 + loader, filename = "NLOAD", guard = &7C00
    INCLUDE "loader.6502"
ENDSECTION


\ The game's own state that lasts: fixed zero page (not baron's pool,
\ which is the rest of zero page up to DATA_BANK_ZP). The original's
\ variables are in vars_ba and vars_ff (decision 10).
ZP_FIXED = &40
SECTION ZeroPage, org = &00, guard = ZP_FIXED, virtual = TRUE
.vsyncs     SKIP 1          ; counts VSyncs (irq.6502)
.seed       SKIP 1          ; the random generator's state (level.6502)
.floor_ink  SKIP 1          ; the level's floor colour, a Spectrum ink (colour.6502)
.passes     SKIP 1          ; counts the pass clock's ticks (irq.6502)
    \ The Z80's registers (regs.6502): rb and rc together are BC (rc the
    \ low byte), rd and re DE, rh and rl HL; rhl is HL as a pointer.
.rc         SKIP 1
.rb         SKIP 1
.re         SKIP 1
.rd         SKIP 1
.rl         SKIP 1
.rh         SKIP 1
rhl = rl
.ra2        SKIP 1          ; a spare place for what the Z80 keeps in AF' or on its stack
.pl         SKIP 1          ; the player a shared routine is for: 0 or 1 (player.6502)
.prec       SKIP 1          ; ... and its record's offset from Player1 (0 or Player2 - Player1)
.sp_attr    SKIP 1          ; draw_sprite's attribute (sprite.6502)
.sp_top     SKIP 1          ; which parts of the picture show: bit 7 set if so
.sp_bottom  SKIP 1
.sp_left    SKIP 1
.sp_right   SKIP 1
.scan_at    SKIP 2          ; the monsters' scan (monsters.6502): fixed, as a hit's game over
.scan_rows  SKIP 1          ; ... starts a new game from inside it
.scan_cols  SKIP 1
.scan_y     SKIP 1          ; ... the tile's offset in its row
.st         SKIP 1          ; the star a routine is for: its offset from Star1 (stars.6502)
.noise_seed SKIP 1          ; the sounds' own random numbers (sound.6502)
.music_key_held SKIP 1      ; the music's key, until seen released (the original's &B8E0)
.music_off  SKIP 1          ; bit 7: the music is off (EXTEND+T; the original's &B8DF)
.pass_sp    SKIP 1          ; the stack at a player's pass, for its exit (player.6502)
.sh_steps   SKIP 1          ; a slide's steps so far, its attributes not yet moved (shift.6502)
.sh_prog    SKIP 1          ; ... and its shift's program
.sp_mode    SKIP 1          ; draw_sprite's: SP_PIXELS, SP_ATTRS or 0 (sprite.6502)
.dt_whole   SKIP 1          ; bit 7: draw_block_at's stores are all STAs
    \ The music (music.6502): the interrupt's, so not in baron's pool
.mu_on      SKIP 1          ; non-zero: a song is playing (&C00C)
.mu_busy    SKIP 1          ; non-zero: the game is writing the sound chip
.mu_ptr     SKIP 2          ; the pattern being read
.mu_ptr2    SKIP 2          ; an envelope, an arpeggio, a list
.mu_per     SKIP 2          ; mu_render's period
.mu_off     SKIP 2          ; ... and its vibrato's offset
.mu_flags   SKIP 1          ; ... the voice's flags as the frame began
.mu_span    SKIP 1          ; ... the vibrato's span
.mu_idx     SKIP 1          ; ... the note doubled
.mu_tmp     SKIP 1
.mu_p       SKIP 2          ; mu_period's AY period
.mu_t       SKIP 3          ; ... its sum
.mu_s       SKIP 2          ; ... and the SN's period
IF DEFINED(MUSICCHECK)
.mc_at      SKIP 2          ; the music check's next record (startup.6502)
.mc_left    SKIP 1          ; ... records left before mc_full
.mc_next    SKIP 1          ; ... a song to start there, or &FF
ENDIF
ENDSECTION

\ OS workspace the game takes once it owns the machine (decision 11): the
\ language's pages, and the sound and buffer pages, whose interrupts are
\ stopped (start, startup.6502).
SECTION Work, org = &0400, guard = &0D9F, virtual = TRUE
.hi_nibble  SKIP &100       ; made at start-up (startup.6502)
.lo_nibble  SKIP &100
.map        SKIP 32 * 32    ; the level being played (the original's &BC00)
    \ What follows the original's map: its code, from &C000, whose first
    \ byte the monsters' scan reads as a tile with the view at the bottom
    \ right (decision 23). Set at start-up (startup.6502).
.map_tail   SKIP MAP_TAIL
.attrs      SKIP SCREEN_ROWS * SCREEN_COLS  ; the original's attributes (&5800, text.6502)
.ink_mask   SKIP 8          ; each Spectrum ink's MODE 1 byte (colour.6502)
    \ The music's driver (music.6502): what the original keeps in bank 1
.mu_voices  SKIP 3 * MU_VOICE   ; the voices (&C069, &C08A, &C0AB)
.mu_rows    SKIP 1          ; frames left of this row (&C0CC)
.mu_speed   SKIP 1          ; frames a row (&C0F9)
.mu_noise_note SKIP 1       ; the last note that set the noise (&C0D8)
.mu_noise   SKIP 1          ; the noise's period this frame (&C125)
.mu_transpose SKIP 1        ; semitones added to every note (&C3A1)
.mu_mix     SKIP 1          ; the mixer's template (&C44A)
.mu_ay      SKIP MU_AY_REGS ; the shadow AY registers (&C47F)
    \ ... and the SN76489's registers as last written (music_dirty)
.mu_sn_lo   SKIP 3          ; each tone's period
.mu_sn_hi   SKIP 3
.mu_sn_att  SKIP 4          ; each channel's attenuation, the noise's last
.mu_sn_noise SKIP 1         ; the noise's register
.mu_bass    SKIP 3          ; octaves each tone went up to fit (decision 18)
ENDSECTION
    ASSERT LO(map) = 0 AND LO(hi_nibble) = 0

MAP_TAIL = 2                ; the original's bytes after its map that its scans can reach

\ NINJA loads at &1900, above the DFS's workspace, and the loader copies
\ it down to CODE_BASE (loader.6502).
CODE_BASE = &0E00
CODE_LOAD = &1900
SECTION Code, org = CODE_BASE, load = &FFFF0000 OR CODE_LOAD, exec = &FFFF0000 + start, filename = "NINJA", guard = screen
    ZA_POOL ZP_FIXED..DATA_BANK_ZP-1
.code_start
    \ The blocks (tools/mkgfx.py) first, where nothing moves them: on a
    \ page, so the drawer's loads never cross one
.blocks
    INCBIN "data/blocks.bin"
    ASSERT LO(blocks) = 0
    \ The shifts next, so the copier's rows start at a page's start
    INCLUDE "shift.6502"
    INCLUDE "irq.6502"
    INCLUDE "view.6502"
    INCLUDE "sprite.6502"
    INCLUDE "mapcell.6502"
    INCLUDE "keys.6502"
    INCLUDE "player.6502"
    INCLUDE "touch.6502"
    INCLUDE "monsters.6502"
    INCLUDE "stars.6502"
    INCLUDE "status.6502"
    INCLUDE "spread.6502"
    INCLUDE "stubs.6502"
    INCLUDE "bomb.6502"
    INCLUDE "sound.6502"
.music_code
    INCLUDE "music.6502"
.music_code_end
    PRINT "music's driver: ", music_code_end - music_code, " bytes"
    \ Data from the original (tools/mkgfx.py, tools/mklevels.py)
.tileattr
TileAttrs = tileattr          ; (the original's &FF02)
    INCBIN "data/tileattr.bin"
    \ What each panel cell shows (text.6502's print_char): &FF, nothing
    \ yet. Until draw_panel sets it, it holds the start-up's code that runs
    \ once; the rest of the start-up follows it.
    INCLUDE "startup.6502"
    \ The original's variables, as the tape leaves them (tools/mkvars.py)
.vars_ba
    INCBIN "data/vars_ba.bin"
.vars_ff
    INCBIN "data/vars_ff.bin"
    INCLUDE "data/vars.6502"
.code_end
    PRINT "code &", ~code_start, "-&", ~code_end, " (", screen - code_end, " bytes free below the screen)"
ENDSECTION

\ What goes in sideways RAM (decision 6): loaded at &3000 and copied to
\ the bank, which the game pages in for good.
SECTION Data, org = &8000, load = &FFFF3000, filename = "NDATA", guard = &C000
.data_magic
    EQUS DATA_MAGIC
    \ The levels (tools/mklevels.py)
.levels
    INCBIN "data/levels.bin"
.levels_end
    INCLUDE "data/levels.6502"
    \ The passwords and the title's colours (tools/mkgfx.py): only the
    \ bank's code reads them (game.6502)
.passwords
    INCBIN "data/passwords.bin"
.title_attr
    INCBIN "data/titleattr.bin"
    \ The status panel, drawn once (panel.6502)
.panel_packed
    INCBIN "data/panel.zx02"
    \ The music's songs (music.6502, tools/mkmusic.py)
.music_data
    INCLUDE "data/music.6502"
.music_data_end
    PRINT "music's songs: ", music_data_end - music_data, " bytes"
    \ Code that needn't be in main RAM (decision 20): the bank is paged in
    \ for good, so code runs from it as well as from main RAM.
.banked_code
    INCLUDE "unpack.6502"
    INCLUDE "level.6502"
    INCLUDE "colour.6502"
    INCLUDE "panel.6502"
    INCLUDE "text.6502"
    INCLUDE "game.6502"
    INCLUDE "menu.6502"
    INCLUDE "songs.6502"
    INCLUDE "musicentry.6502"
.font
    INCBIN "data/font.bin"
.banked_code_end
    PRINT "code in the bank: ", banked_code_end - banked_code, " bytes"
.data_end
    PRINT "sideways data &8000-&", ~data_end, " (", &C000 - data_end, " bytes free)"
ENDSECTION
