\ ***************************************************************************
\ Start-up: take the machine from the OS and set up the screen.
\ ***************************************************************************

.start
{
    ZA_ENTRY
    SEI
    LDX #&FF : TXS
    JSR init_system
    JSR cls
    JSR test_pattern
.idle
    JMP idle
}

\ MODE 1's pixels on the narrowed CRTC, set in the hardware: an OS mode
\ change would want the OS's workspace, which the game takes.
.init_system
{
    LDA #&D8 : STA ula_ctrl         ; MODE 1's pixels: 4 colours, 20 columns of bytes
    LDX #crtc_end - crtc_regs - 2
.crtc
    LDA crtc_regs,X : STA crtc_reg
    LDA crtc_regs+1,X : STA crtc_data
    DEX : DEX : BPL crtc
    LDX #15
.pal
    LDA palette,X : STA ula_pal
    DEX : BPL pal
    LDA #0 : STA vsyncs
    JSR install_irq
    LDA #8 : STA crtc_reg           ; the display on, once it's set up
    LDA #0 : STA crtc_data
    RTS
}

\ Register, value pairs: MODE 1's, but R2 and R7 move with the narrower,
\ shorter picture to keep its centre where MODE 1's is (Chuckie Egg 2's).
.crtc_regs
    EQUB 0, 127
    EQUB 3, &28
    EQUB 4, 38
    EQUB 5, 0
    EQUB 9, 7
    EQUB 10, &20                ; the cursor off
    EQUB 11, 8
    EQUB 1, SCREEN_COLS * 2
    EQUB 2, 98 - (80 - SCREEN_COLS * 2) / 2
    EQUB 6, SCREEN_ROWS
    EQUB 7, 34 - (32 - SCREEN_ROWS) / 2
    EQUB 12, HI(screen / 8)
    EQUB 13, LO(screen / 8)
    EQUB 8, CRTC_BLANK          ; blank until init_system is done
.crtc_end

\ For now black, red, yellow and white: the screen's test colours.
PAL = {0, 1, 3, 7}
.palette
FOR l = 0..3
    FOR n = 0..3
        EQUB ula_entry(l, n, PAL[l])
    NEXT
NEXT
