\ Ninja Massacre's music: David Whittaker's song data from the 128K's
\ bank 1, for src/music.6502's transcription of his driver. Made by
\ tools/mkmusic.py from build/nm128.z80: don't edit it by hand.
\ docs/research/music-driver.md describes the format. Each label
\ ending in an address names the original's address of what it labels.

\ The note table (&C498): each note's AY tone period, low then high
\ bytes, as far up as the songs go.
.mu_periods_lo
    EQUB LO(3832), LO(3600), LO(3424), LO(3200), LO(3032), LO(2856), LO(2696), LO(2544)
    EQUB LO(2400), LO(2272), LO(2136), LO(2016), LO(1916), LO(1800), LO(1712), LO(1600)
    EQUB LO(1516), LO(1428), LO(1348), LO(1272), LO(1200), LO(1136), LO(1068), LO(1008)
    EQUB LO(958), LO(900), LO(856), LO(800), LO(758), LO(714), LO(674), LO(636)
    EQUB LO(600), LO(568), LO(534), LO(504), LO(479), LO(450), LO(428), LO(400)
    EQUB LO(379), LO(357), LO(337), LO(318), LO(300), LO(284), LO(267), LO(252)
    EQUB LO(239), LO(225), LO(214), LO(200), LO(189), LO(178), LO(168), LO(159)
    EQUB LO(150), LO(142), LO(133), LO(126), LO(119), LO(112), LO(107), LO(100)
.mu_periods_hi
    EQUB HI(3832), HI(3600), HI(3424), HI(3200), HI(3032), HI(2856), HI(2696), HI(2544)
    EQUB HI(2400), HI(2272), HI(2136), HI(2016), HI(1916), HI(1800), HI(1712), HI(1600)
    EQUB HI(1516), HI(1428), HI(1348), HI(1272), HI(1200), HI(1136), HI(1068), HI(1008)
    EQUB HI(958), HI(900), HI(856), HI(800), HI(758), HI(714), HI(674), HI(636)
    EQUB HI(600), HI(568), HI(534), HI(504), HI(479), HI(450), HI(428), HI(400)
    EQUB HI(379), HI(357), HI(337), HI(318), HI(300), HI(284), HI(267), HI(252)
    EQUB HI(239), HI(225), HI(214), HI(200), HI(189), HI(178), HI(168), HI(159)
    EQUB HI(150), HI(142), HI(133), HI(126), HI(119), HI(112), HI(107), HI(100)
MU_NOTES = 64

\ Each arpeggio, for C0-CF in a pattern (the offsets at &C558),
\ low then high bytes. Those no song uses are 0.
.mu_arp_lo
    EQUB LO(mu_arp_0), LO(mu_arp_1), 0, 0, LO(mu_arp_4), LO(mu_arp_5), LO(mu_arp_6)
.mu_arp_hi
    EQUB HI(mu_arp_0), HI(mu_arp_1), 0, 0, HI(mu_arp_4), HI(mu_arp_5), HI(mu_arp_6)
MU_ARPS = 7

\ Each instrument, for D0-DF in a pattern (the pointers at &C575,
\ here to its step time, the byte before),
\ low then high bytes. Those no song uses are 0.
.mu_inst_lo
    EQUB 0, LO(mu_inst_1 - 1), 0, LO(mu_inst_3 - 1), LO(mu_inst_4 - 1), 0, LO(mu_inst_6 - 1), 0, 0, LO(mu_inst_9 - 1), 0, LO(mu_inst_11 - 1)
.mu_inst_hi
    EQUB 0, HI(mu_inst_1 - 1), 0, HI(mu_inst_3 - 1), HI(mu_inst_4 - 1), 0, HI(mu_inst_6 - 1), 0, 0, HI(mu_inst_9 - 1), 0, HI(mu_inst_11 - 1)
MU_INSTS = 12

\ Each pattern's address, for its number in a pattern list (from 1),
\ low then high bytes.
.mu_pat_lo
    EQUB LO(mu_pat_C8E2), LO(mu_pat_C90C), LO(mu_pat_C934), LO(mu_pat_C94C), LO(mu_pat_C967), LO(mu_pat_C9AF), LO(mu_pat_C9D9), LO(mu_pat_CA06)
    EQUB LO(mu_pat_CA15), LO(mu_pat_CA50), LO(mu_pat_CA7B), LO(mu_pat_CA96), LO(mu_pat_CAAE), LO(mu_pat_CAC5), LO(mu_pat_CAE2), LO(mu_pat_CAF2)
    EQUB LO(mu_pat_CB0E), LO(mu_pat_CB2D), LO(mu_pat_CB3E), LO(mu_pat_CB4E), LO(mu_pat_CB76), LO(mu_pat_CB78), LO(mu_pat_CB7B), LO(mu_pat_CB7E)
.mu_pat_hi
    EQUB HI(mu_pat_C8E2), HI(mu_pat_C90C), HI(mu_pat_C934), HI(mu_pat_C94C), HI(mu_pat_C967), HI(mu_pat_C9AF), HI(mu_pat_C9D9), HI(mu_pat_CA06)
    EQUB HI(mu_pat_CA15), HI(mu_pat_CA50), HI(mu_pat_CA7B), HI(mu_pat_CA96), HI(mu_pat_CAAE), HI(mu_pat_CAC5), HI(mu_pat_CAE2), HI(mu_pat_CAF2)
    EQUB HI(mu_pat_CB0E), HI(mu_pat_CB2D), HI(mu_pat_CB3E), HI(mu_pat_CB4E), HI(mu_pat_CB76), HI(mu_pat_CB78), HI(mu_pat_CB7B), HI(mu_pat_CB7E)
MU_PATS = 24

\ The rest as the original keeps it, in its order: the song table, the
\ pattern lists (a pattern's number for each address, 0 the list's
\ end), the patterns, the instruments (each a step time, then volumes)
\ and the arpeggios; only the bytes the songs read.
