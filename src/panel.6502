\ ***************************************************************************
\ The status panel: the screen's left 8 columns. The original never draws
\ it: it keeps the loading screen's (docs/research.md). The port draws it
\ once, from panel.zx02 (tools/mkgfx.py), unpacked into the map's room
\ before there's a level (decision 20), in colours that don't change with
\ the level (decision 5): yellow as yellow, black as black, any other in
\ logical 3.

panel = map                         ; (unpacked here first)
PANEL_COLS = 8
PANEL_CELLS = SCREEN_ROWS * PANEL_COLS
panel_attrs = panel                 ; the cells' attributes, a row at a time
panel_pixels = panel + PANEL_CELLS  ; then each cell's 8 lines, in the same order
\ ***************************************************************************

\ Each cell is drawn as a glyph (text.6502's draw_glyph), which also sets
\ its attribute in attrs, where print finds it. attrs is above the panel's
\ start, and the cells go from the last: a cell's attribute lands past
\ every byte of the unpacked panel still to be read, the last cell's
\ worst of all.
    ASSERT attrs + (SCREEN_ROWS - 1) * SCREEN_COLS + PANEL_COLS - 1 >= panel_pixels + PANEL_CELLS * 8
    ASSERT PANEL_CELLS < 256 AND PANEL_COLS = 8
.draw_panel
{
    LDA #&FF : LDX #PANEL_CELLS
.unshown
    STA panel_shown - 1,X
    DEX : BNE unshown
    JSR panel_inks                  ; (where draw_glyph finds them)
    LDA #LO(panel_packed) : STA zsrc : LDA #HI(panel_packed) : STA zsrc + 1
    LDA #LO(panel) : STA zdst : LDA #HI(panel) : STA zdst + 1
    JSR unzx02
    LDA #LO(panel_pixels + PANEL_CELLS * 8) : STA gl_src
    LDA #HI(panel_pixels + PANEL_CELLS * 8) : STA gl_src + 1
    LDA #PANEL_CELLS : STA left
.cell
    LDA gl_src : SEC : SBC #8 : STA gl_src
    BCS s : DEC gl_src + 1
.s
    DEC left
    LDX left : LDA panel_attrs,X : PHA
    TXA : AND #PANEL_COLS - 1 : TAY
    TXA : LSR A : LSR A : LSR A : TAX
    PLA : JSR draw_glyph
    LDA left : BNE cell
    RTS
    ZA_AUTO1 left             ; cells left to draw
}
