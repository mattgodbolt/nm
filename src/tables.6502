\ ***************************************************************************
\ Tables, made at start-up in the OS workspace the game takes (decision
\ 20). A byte of one-bit pixels becomes two MODE 1 bytes in colour 3:
\ hi_nibble from its left four pixels, lo_nibble from its right four.
\ MODE 1 keeps a pixel's two bits in bits 7 and 3 (the leftmost) down to 4
\ and 0, so four one-bit pixels n make n * &11.
\ ***************************************************************************

.make_tables
{
    LDX #0
.next
    TXA : AND #&0F : STA tmp : ASL A : ASL A : ASL A : ASL A : ORA tmp
    STA lo_nibble,X
    TXA : LSR A : LSR A : LSR A : LSR A : TAY  ; (lo_nibble's entry Y, at most X, is made)
    LDA lo_nibble,Y : STA hi_nibble,X
    INX : BNE next
    RTS
    ZA_AUTO1 tmp
}
