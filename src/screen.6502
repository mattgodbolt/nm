\ ***************************************************************************
\ The screen.
\ ***************************************************************************

\ Clear the whole screen to logical colour 0.
.cls
{
    ZA_AUTO2 ptr
    LDA #0 : STA ptr : TAY
    LDX #HI(screen) : STX ptr+1
.page
    STA (ptr),Y
    INY : BNE page
    INC ptr+1 : BPL page
    RTS
}
