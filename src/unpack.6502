\ ***************************************************************************
\ ZX02, unpacked (decision 4): tools/zx02.py packs, and its decompress() is
\ the reference this follows. The stream: a bit says literals or a match;
\ lengths and offsets' high parts are interlaced Elias gamma codes; a new
\ offset's low byte carries the first bit of the length after it in its bit
\ 0. Lengths are 8-bit, 0 meaning 256; an offset whose gamma wraps to 0
\ ends the stream.
\ ***************************************************************************

ZA_AUTO2 zsrc               ; the next byte of the stream
ZA_AUTO2 zdst               ; where the next byte goes
ZA_AUTO2 zcp                ; a match's source
ZA_AUTO2 zoff               ; the offset - 1: zdst - zoff - 1 is the match
ZA_AUTO1 zbits              ; the bit buffer: a 1 shifted in behind the bits

\ Unpack the stream at zsrc to zdst. Y stays 0 throughout, so (zp),Y
\ reads and writes at the pointer itself.
.unzx02
{
    LDY #0
    LDA #&80 : STA zbits
    STY zoff : STY zoff+1           ; the first offset is 1
.literals
    JSR gamma
.literal
    JSR next_byte
    STA (zdst),Y
    INC zdst : BNE l : INC zdst+1
.l
    DEX : BNE literal
    JSR getbit : BCS new_offset
    \ a match at the last offset
    JSR gamma
    JMP match
.new_offset
    JSR gamma                       ; the offset's high part, plus one
    TXA : BEQ done                  ; (256: the end)
    \ offset - 1 = (high - 1) * 128 + (low >> 1); its bit 0 is the length's
    \ first bit
    DEX : TXA : LSR A : STA zoff+1
    JSR next_byte                   ; (which keeps C: the high part's bit 0)
    ROR A : STA zoff                ; (... in, and low bit 0 out to C)
    JSR gamma_c
    INX                             ; the length is one more
.match
    CLC                             ; (zdst - zoff - 1)
    LDA zdst : SBC zoff : STA zcp
    LDA zdst+1 : SBC zoff+1 : STA zcp+1
.copy
    LDA (zcp),Y
    INC zcp : BNE c : INC zcp+1
.c
    STA (zdst),Y
    INC zdst : BNE d : INC zdst+1
.d
    DEX : BNE copy
    JSR getbit : BCC literals
    BCS new_offset                  ; (always)
.done
    RTS
}

\ An interlaced Elias gamma value into X (8-bit: 0 is 256), its first
\ continuation bit read (gamma) or in C (gamma_c).
.gamma
    JSR getbit
.gamma_c
{
    LDX #1
    BCC done
.more
    JSR getbit
    TXA : ROL A : TAX
    JSR getbit : BCS more
.done
    RTS
}

\ The stream's next bit, in C.
.getbit
{
    ASL zbits : BNE done
    JSR next_byte
    SEC : ROL A : STA zbits
.done
    RTS
}

\ The stream's next byte, in A (Y = 0), keeping C.
.next_byte
{
    LDA (zsrc),Y
    INC zsrc : BNE done : INC zsrc+1
.done
    RTS
}
