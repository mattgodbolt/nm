\ ***************************************************************************
\ Text, and the attributes. The original's print (&D9AA) writes a glyph's
\ pixels and leaves the cell's attribute as it is, so the cell's colours
\ come from whatever set that attribute last. The port keeps the
\ attributes the original would have (attrs: 24 rows of 32, as &5800), and
\ draws each cell's pixels in the colours its attribute gives (decision 8).
\ ***************************************************************************

\ The colours of attribute A as MODE 1 bytes: dt_paper, and dt_mask (the
\ ink's EOR the paper's), as the block drawer wants them.
.attr_colours
{
    PHA
    LSR A : LSR A : LSR A : AND #7 : TAY
    LDA ink_mask,Y : STA dt_paper
    PLA : AND #7 : TAY
    LDA ink_mask,Y : EOR dt_paper : STA dt_mask
    RTS
}

\ &C487: clear the playfield (columns 8-31), its attributes to A.
.clear_view
{
    ZA_AUTO2 at
    STA fill
    JSR attr_colours
    \ the attributes: every one not in the panel's columns (0-7: bits 3
    \ and 4 of the offset clear)
    ASSERT SCREEN_ROWS * SCREEN_COLS = &300 AND SCREEN_COLS = 32 AND VIEW_LEFT = 8
    LDX #0
.attr
    TXA : AND #&18 : BEQ in_panel
    LDA fill
    STA attrs,X : STA attrs + &100,X : STA attrs + &200,X
.in_panel
    INX : BNE attr
    \ the pixels, all paper: each row's playfield is 256 bytes, then the
    \ rest of it before the next row's panel
    ASSERT ROW_BYTES - VIEW_LEFT * 16 > &100
    LDA #LO(screen + VIEW_LEFT * 16) : STA at
    LDA #HI(screen + VIEW_LEFT * 16) : STA at+1
    LDX #SCREEN_ROWS
.prow
    LDY #0
    LDA dt_paper
.pcol
    STA (at),Y
    INY : BNE pcol
    INC at+1
    LDY #0
.pcol2
    STA (at),Y
    INY : CPY #LO(ROW_BYTES - VIEW_LEFT * 16 - &100) : BNE pcol2
    INC at+1                    ; (the next row's playfield: 256 on)
    DEX : BNE prow
    RTS
    ZA_AUTO1 fill
}

\ &D995: print the string after the JSR (ending with 0) at row Y,
\ column X; it returns after the string. (The original passes the row and
\ column in DE.)
.print_at
{
    STX PrintPos : STY PrintPos+1
    \ (fall into print_inline)
}
.print_inline
{
    PLA : STA str
    PLA : STA str+1
    JSR print_str
    LDA str+1 : PHA
    LDA str : PHA
    RTS
}

\ Print the string after str (ending with 0), leaving str at its 0.
.print_str
{
.next
    INC str : BNE c : INC str+1
.c
    LDY #0 : LDA (str),Y : BEQ done
    JSR print_char
    JMP next
.done
    RTS
}
ZA_AUTO2 str

\ &D9AA: print character A at the cursor, in the cell's colours, and move
\ the cursor on (to the next row after column 31, and to the top after the
\ last row).
.print_char
{
    \ In the panel, a character already shown isn't drawn again (decision
    \ 22): the original reprints the figures and icons on every touch,
    \ up to three times a pass, and each costs the BBC far more.
    LDX PrintPos : CPX #PANEL_COLS : BCS draw
    PHA
    LDA PrintPos + 1 : ASL A : ASL A : ASL A : ORA PrintPos : TAX
    PLA
    CMP panel_shown,X : BEQ advance
    STA panel_shown,X
.draw
    \ the glyph: font + 8 * (A - FONT_FIRST), as (font - 8 * FONT_FIRST) + 8 * A
    LDX #0 : STX gl_src + 1
    ASL A : ROL gl_src + 1 : ASL A : ROL gl_src + 1 : ASL A : ROL gl_src + 1
    ADC #LO(font - 8 * FONT_FIRST) : STA gl_src     ; (C clear: the last ROL took a 0 from gl_src + 1)
    LDA gl_src + 1 : ADC #HI(font - 8 * FONT_FIRST) : STA gl_src + 1
    \ in the cell's colours
    LDX PrintPos + 1 : LDY PrintPos
    LDA attr_row_lo,X : STA gl_at
    LDA attr_row_hi,X : STA gl_at + 1
    LDA (gl_at),Y
    JSR draw_glyph
.advance
    \ the cursor
    INC PrintPos
    LDA PrintPos : CMP #SCREEN_COLS : BNE done
    LDA #0 : STA PrintPos
    INC PrintPos+1
    LDA PrintPos+1 : CMP #SCREEN_ROWS : BNE done
    LDA #0 : STA PrintPos+1
.done
    RTS
}

\ Draw the 8 x 8 pattern at gl_src in character cell (X, Y), whose
\ attribute becomes A (the original's StarCell writes the attribute;
\ print writes the one the cell has, as it leaves it).
.draw_glyph
{
    STX gl_row : STY gl_col
    PHA
    LDA attr_row_lo,X : STA gl_at
    LDA attr_row_hi,X : STA gl_at + 1
    PLA : STA (gl_at),Y
    JSR attr_colours                ; (which uses X and Y)
    \ the screen: screen + row * &200 + col * 16 (the column's bit 4 is
    \ the carry the shifts leave, which ROL takes into the high byte)
    LDA gl_col : ASL A : ASL A : ASL A : ASL A : STA gl_at
    LDA gl_row : ROL A : ADC #HI(screen) : STA gl_at + 1     ; (C clear: the row's top bit)
    ASSERT LO(screen) = 0 AND SCREEN_COLS = 32 AND SCREEN_ROWS < 128
    LDY #0
.line
    STY gl_tmp
    LDA (gl_src),Y : TAX
    LDA hi_nibble,X : AND dt_mask : EOR dt_paper : STA (gl_at),Y
    TYA : ORA #8 : TAY
    LDA lo_nibble,X : AND dt_mask : EOR dt_paper : STA (gl_at),Y
    LDY gl_tmp : INY : CPY #8 : BNE line
    RTS
}
ZA_AUTO2 gl_at
ZA_AUTO2 gl_src
ZA_AUTO1 gl_tmp
ZA_AUTO1 gl_row
ZA_AUTO1 gl_col
FONT_FIRST = &20            ; font.bin's first code (the original's font is indexed from &F400)
