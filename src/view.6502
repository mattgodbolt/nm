\ ***************************************************************************
\ The view: 12 x 12 tiles of the map, from (ViewOrigin, ViewOrigin+1), in
\ characters, drawn in the screen's columns 8-31 (&C54C).
\ ***************************************************************************

VIEW_LEFT = 8               ; the view's first screen column (the panel's left of it)

\ Draw the whole view (&C54C).
.draw_view
{
    ZA_AUTO2 cell
    ZA_AUTO1 col
    ZA_AUTO1 row
    \ &C574: the map's cell at the view's origin
    LDA ViewOrigin : LSR A : STA cell+1
    LDA #0 : LSR cell+1 : ROR A : LSR cell+1 : ROR A : LSR cell+1 : ROR A
    STA cell
    LDA ViewOrigin+1 : LSR A : AND #&1F : ORA cell : STA cell
    LDA cell+1 : CLC : ADC #HI(map) : STA cell+1
    LDA #0 : STA row
.rows
    LDA #VIEW_LEFT : STA col
.cols
    LDY #0 : LDA (cell),Y
    LDX row : LDY col
    JSR draw_cell
    INC cell : BNE c : INC cell+1
.c
    LDA col : CLC : ADC #2 : STA col
    CMP #SCREEN_COLS : BCC cols
    LDA cell : CLC : ADC #32 - 12 : STA cell
    BCC c2 : INC cell+1
.c2
    LDA row : CLC : ADC #2 : STA row
    CMP #SCREEN_ROWS : BCC rows
    RTS
}

\ &C59A: draw the map's tile A at screen row X, column Y (characters).
\ Players and monsters (&40 and up) are drawn as floor; the walls'
\ variant bits (3 and 4) are dropped.
.draw_cell
{
    CMP #&40 : BCC lo
    LDA #0
.lo
    CMP #&20 : BCC draw
    AND #&27
.draw
    \ (fall into draw_tile)
}

\ Draw tile or block A (its graphic at blocks + 32A, its colours from the
\ original's attribute for it, &FF02, which its 2 x 2 cells take) at
\ screen row X, column Y. (Flash, which only tile &13 has, isn't shown
\ yet.)
.draw_tile
{
    PHA : STX ra2
    TAX : LDA tileattr,X : STA sp_attr
    LDX ra2 : PLA
    JMP draw_sprite
}

\ Draw block A at (dt_row, dt_col): a set pixel in dt_mask EOR dt_paper,
\ the rest in dt_paper (the colours' MODE 1 bytes; dt_mask is the ink's
\ EOR the paper's, so (pixels AND dt_mask) EOR dt_paper is either). The
\ block is four quarters of eight lines (tools/mkgfx.py), so one loop
\ draws a line of each, its addresses written into the loop: each
\ quarter's source, and the two screen bytes each of its lines makes. A
\ quarter that doesn't show (sp_top and the rest) has its stores made
\ CMPs, which leave the screen alone.
OP_STA_ABSY = &99
OP_CMP_ABSY = &D9
    ASSERT (OP_STA_ABSY EOR OP_CMP_ABSY) = &40
.draw_block_at
{
    \ the quarters: blocks + 32A, then 8 on each
    TAY
    LSR A : LSR A : LSR A : STA bsrc+1
    TYA : ASL A : ASL A : ASL A : ASL A : ASL A
    CLC : ADC #LO(blocks) : STA src0+1
    LDA bsrc+1 : ADC #HI(blocks) : STA src0+2
    LDX #0
.srcs
    LDA src0+1,X : CLC : ADC #8 : STA src1+1,X
    LDA src0+2,X : ADC #0 : STA src1+2,X
    TXA : CLC : ADC #src1 - src0 : TAX
    CPX #3 * (src1 - src0) : BNE srcs
    \ the screen: screen + row * &200 + col * 16, the right quarters 16
    \ on, the bottom a character row (&200) on; each line's second byte 8
    \ on from its first (col * 16 is a multiple of 16: no carry)
    LDA dt_col : ASL A : ASL A : ASL A : ASL A
    STA dst0+1 : STA dst2+1
    ORA #8 : STA dst0b+1 : STA dst2b+1
    AND #&F0 : CLC : ADC #16
    STA dst1+1 : STA dst3+1
    ORA #8 : STA dst1b+1 : STA dst3b+1
    LDA dt_col : LSR A : LSR A : LSR A : LSR A : STA bsrc+1
    LDA dt_row : ASL A : CLC : ADC bsrc+1
    ADC #HI(screen)                                     ; (C clear: the ADC above made at most &FF)
    STA dst0+2 : STA dst0b+2
    CLC : ADC #2 : STA dst2+2 : STA dst2b+2             ; (row -1 wraps below the screen: only its bottom half shows)
    LDA dst0+1 : CMP #&F0                               ; (C set if the right quarters are a page on)
    LDA dst0+2 : ADC #0 : STA dst1+2 : STA dst1b+2
    ADC #2 : STA dst3+2 : STA dst3b+2                   ; (C clear: the screen's pages are below &80)
    \ which quarters show: STA, or CMP
    LDA sp_top : AND sp_left : AND #&40 : EOR #OP_CMP_ABSY : STA dst0 : STA dst0b
    LDA sp_top : AND sp_right : AND #&40 : EOR #OP_CMP_ABSY : STA dst1 : STA dst1b
    LDA sp_bottom : AND sp_left : AND #&40 : EOR #OP_CMP_ABSY : STA dst2 : STA dst2b
    LDA sp_bottom : AND sp_right : AND #&40 : EOR #OP_CMP_ABSY : STA dst3 : STA dst3b
    LDY #7
.line
.src0
    LDX &FFFF,Y
    LDA hi_nibble,X : AND dt_mask : EOR dt_paper
.dst0
    STA &FFFF,Y
    LDA lo_nibble,X : AND dt_mask : EOR dt_paper
.dst0b
    STA &FFFF,Y
.src1
    LDX &FFFF,Y
    LDA hi_nibble,X : AND dt_mask : EOR dt_paper
.dst1
    STA &FFFF,Y
    LDA lo_nibble,X : AND dt_mask : EOR dt_paper
.dst1b
    STA &FFFF,Y
.src2
    LDX &FFFF,Y
    LDA hi_nibble,X : AND dt_mask : EOR dt_paper
.dst2
    STA &FFFF,Y
    LDA lo_nibble,X : AND dt_mask : EOR dt_paper
.dst2b
    STA &FFFF,Y
.src3
    LDX &FFFF,Y
    LDA hi_nibble,X : AND dt_mask : EOR dt_paper
.dst3
    STA &FFFF,Y
    LDA lo_nibble,X : AND dt_mask : EOR dt_paper
.dst3b
    STA &FFFF,Y
    DEY : BPL line
    RTS
    ASSERT src2 - src1 = src1 - src0 AND src3 - src2 = src1 - src0
}
ZA_AUTO2 bsrc
ZA_AUTO1 dt_row
ZA_AUTO1 dt_col
ZA_AUTO1 dt_mask
ZA_AUTO1 dt_paper
