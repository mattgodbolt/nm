\ ***************************************************************************
\ The view: 12 x 12 tiles of the map, from (ViewOrigin, ViewOrigin+1), in
\ characters, drawn in the screen's columns 8-31 (&C54C).
\ ***************************************************************************

VIEW_LEFT = 8               ; the view's first screen column (the panel's left of it)

\ Draw the whole view (&C54C).
.draw_view
{
    ZA_AUTO2 cell
    ZA_AUTO1 col
    ZA_AUTO1 row
    \ &C574: the map's cell at the view's origin: map + 32 * (row / 2) +
    \ column / 2, the row's nibbles as map_cell takes them
    LDY ViewOrigin
    LDA lo_nibble,Y : AND #&E0 : STA cell       ; (the tile row's low three bits, times 32)
    LDA hi_nibble,Y : AND #3
    CLC : ADC #HI(map) : STA cell+1             ; (its top two)
    LDA ViewOrigin+1 : LSR A : AND #&1F : ORA cell : STA cell
    LDA #0 : STA row
.rows
    LDA #VIEW_LEFT : STA col
.cols
    LDY #0 : LDA (cell),Y
    LDX row : LDY col
    JSR draw_cell
    INC cell : BNE c : INC cell+1
.c
    LDA col : CLC : ADC #2 : STA col
    CMP #SCREEN_COLS : BCC cols
    LDA cell : ADC #32 - 12 - 1 : STA cell      ; (C set: the CMP)
    BCC c2 : INC cell+1
.c2
    LDA row : CLC : ADC #2 : STA row
    CMP #SCREEN_ROWS : BCC rows
    RTS
}

\ A tile's attributes alone, at screen row X, column Y, for slide_attrs
\ (shift.6502). Its strips show whole, as the slide's own did, which left
\ sp_left and sp_right set.
.tile_attrs
    STY dt_col
    JSR sprite_attrs
    INX : JMP sprite_attrs

\ &C59A: draw the map's tile A at screen row X, column Y (characters).
\ Players and monsters (&40 and up) are drawn as floor; the walls'
\ variant bits (3 and 4) are dropped.
.draw_cell
{
    CMP #&40 : BCC lo
    LDA #0
.lo
    CMP #&20 : BCC draw
    AND #&27
.draw
    \ (fall into draw_tile)
}

\ Draw tile or block A (the block of that number, in the colours of the
\ original's attribute for it, &FF02, which its 2 x 2 cells take) at
\ screen row X, column Y. (Flash, which only tile &13 has, isn't shown
\ yet.)
.draw_tile
{
    STX ra2
    TAX : LDA tileattr,X : STA sp_attr
    TXA : LDX ra2
    BIT sp_mode : BVS tile_attrs
    \ (fall into draw_sprite: main.6502 includes sprite.6502 next)
}
.draw_tile_end
