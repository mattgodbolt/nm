\ ***************************************************************************
\ Colour: the original's attributes give each tile one ink on black paper.
\ The BBC has four colours; each level maps the Spectrum's inks to them
\ (decision 5).
\ ***************************************************************************

\ The Spectrum's colours (0-7: black, blue, red, magenta, green, cyan,
\ yellow, white) as the BBC's physical ones.
.zx_to_bbc
    EQUB 0, 4, 1, 5, 2, 6, 3, 7

FLOOR_TILES = {&00, &16, &1E}  ; the tiles whose ink is the level's floor colour (&C357)

\ Set up level A's colours (0-49): &C357 sets the floor's ink, ((A + 1)
\ AND 3) + 1, in the floor tiles' attributes; the BBC's logical colours
\ follow from it.
.level_colours
{
    CLC : ADC #1 : AND #3 : ADC #1 : STA floor_ink
    \ (&C357: tiles &00, &16 and &1E take it as their attribute)
    STA tileattr + &00 : STA tileattr + &16 : STA tileattr + &1E
    \ the inks: black, yellow (the walls), the floor (never black or
    \ yellow), and the rest in 3; but with player 2 in the level, their
    \ green in 2 and the floor in 3 with the rest (InPlay's bit 1, or
    \ bit 3 for a player who left by the exit, before next_level moves it)
    JSR panel_inks
    LDX #P2_COLOUR AND 7
    LDA InPlay : AND #&0A : BNE two
    LDX floor_ink
.two
    LDA #cbyte(2) : STA ink_mask,X
    \ the palette: black and yellow (as pal_phys keeps them), that one,
    \ cyan
    LDA zx_to_bbc,X : LDX #LEVEL_PHYS3
    \ (fall into set_palette)
}

\ The palette with logical colours 2 and 3 physical A and X (pal_phys).
.set_palette
    STA pal_phys + 2 : STX pal_phys + 3
    \ (fall into load_palette)

\ The ULA's palette from pal_phys, the logical colours' physical ones.
.load_palette
{
    LDX #15
.pal
    \ (MODE 1: a pixel's logical colour is index bits 3 and 1)
    TXA : LSR A : AND #1 : STA tmp
    TXA : LSR A : LSR A : AND #2 : ORA tmp : TAY
    TXA : ASL A : ASL A : ASL A : ASL A
    ORA pal_phys,Y : EOR #7     ; (the ULA takes the physical colour EOR 7)
    STA ula_pal
    DEX : BPL pal
    RTS
    ZA_AUTO1 tmp
}

\ The logical colours' physical ones (decision 5): black and yellow on
\ every screen, then two that a level or the menu sets (a level's floor
\ and cyan; the menu's flashing paper and ink, menu.6502).
LEVEL_PHYS3 = 6
.pal_phys
    EQUB 0, 3, 0, LEVEL_PHYS3

\ The inks of the panel's colours (decision 5): yellow as yellow, black
\ as black, any other in logical 3. A level's are these, with its floor's
\ in logical 2.
.panel_inks
{
    LDX #7
.inks
    LDA panel_ink,X : STA ink_mask,X
    DEX : BPL inks
    RTS
}
\ Each Spectrum colour's MODE 1 byte in them.
.panel_ink
    EQUB cbyte(0), cbyte(3), cbyte(3), cbyte(3), cbyte(3), cbyte(3), cbyte(1), cbyte(3)
